* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_EP_UI_CHECKLIST->/RPM/IF_EX_ITEM_API~DECISION_ACTION
* +-------------------------------------------------------------------------------------------------+
* | [--->] IS_CONTEXT                     TYPE        /RPM/TS_OBJECT_HIER
* | [--->] IT_DECISION_ATTR               TYPE        /RPM/TT_DECISION_API
* | [--->] IV_LANGUAGE                    TYPE        LAISO
* | [--->] IV_CHANGE_MODE                 TYPE        CHAR1
* | [<-->] EV_RC                          TYPE        I
* | [<-->] ET_MSG                         TYPE        /RPM/TT_MESSAGES
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD /rpm/if_ex_item_api~decision_action.     "  Method Implementation by 116599

    "----------------------------------------------------------------------
    " Auto-create a PPM Item Snapshot when DP status is ZDP06/ZDP04/ZDP05
    " Uses fields verified in your system:
    "   IS_CONTEXT ( /RPM/TS_OBJECT_HIER ) : OBJECT_GUID
    "   /RPM/ITEM_D                        : GUID, STATUS
    "   /RPM/PHASE_T                       : LANGU, ITEM_TYPE, PHASE_ID, PHASE_TEXT
    "   T002                               : LAISO -> SPRAS
    "----------------------------------------------------------------------

    "---- Local data (strict typing to your tables) -----------------------
    DATA: lv_item_guid     TYPE /rpm/item_d-guid,         " RAW16
          lv_item_status   TYPE /rpm/item_d-status,       " CHAR
          lv_phase_text    TYPE string,
          lv_phase_id      TYPE /rpm/phase_t-phase_id,
          lv_item_type     TYPE /rpm/phase_t-item_type,
          lv_spras         TYPE spras,
          lv_date_c(10),
          lv_time_c(5),
          lv_ts            TYPE string,
          lv_ver_info_id   TYPE string,
          lv_ver_info_name TYPE string,
          lv_seg2          TYPE c LENGTH 2,
          lv_seg3          TYPE c LENGTH 4,
          lt_item_guids    TYPE /rpm/tt_guid,
          ls_item_guid     TYPE /rpm/ts_guid,
          lv_version_type  TYPE inm_tv_version_type,
          lv_hdr_name      TYPE /rpm/tv_version_name,  " header name (ID)
          lv_cp_name       TYPE /rpm/tv_version_name.  " display name (upper-cased)

    FIELD-SYMBOLS: <ls_dec> TYPE any,
                   <fs_val> TYPE any.

    CLEAR ev_rc.

    "----------------------------------------------------------------------
    " 1) Item GUID from IS_CONTEXT exactly as per structure: OBJECT_GUID
    "----------------------------------------------------------------------
    lv_item_guid = is_context-object_guid.
    IF lv_item_guid IS INITIAL.
      RETURN.  " cannot proceed without item
    ENDIF.

    "----------------------------------------------------------------------
    " 2) Read Item STATUS from /RPM/ITEM_D using GUID
    "----------------------------------------------------------------------
    CLEAR lv_item_status.
*    SELECT SINGLE status
*      FROM /rpm/item_d
*      INTO lv_item_status
*     WHERE guid = lv_item_guid.
    SELECT SINGLE status
      FROM zi_rpm_item_d
      INTO @lv_item_status
     WHERE guid = @lv_item_guid.
    IF sy-subrc <> 0 OR lv_item_status IS INITIAL.
      RETURN.
    ENDIF.

    CASE lv_item_status.
      WHEN 'ZDP04'. lv_seg3 = 'HOLD'.  " On Hold
      WHEN 'ZDP05'. lv_seg3 = 'DECL'.  " Declined
      WHEN 'ZDP06'. lv_seg3 = 'APRV'.  " Approved
      WHEN OTHERS.
        RETURN. " Not a trigger status
    ENDCASE.

    "----------------------------------------------------------------------
    " 3) Get PHASE_ID / PHASE_TEXT / ITEM_TYPE from IT_DECISION_ATTR
    "    Prefer ACTIVE = 'X' row; if not present, take first row.
    "    These component names exist in /RPM/TS_DECISION_ATTR in your system.
    "----------------------------------------------------------------------
    CLEAR: lv_phase_text, lv_phase_id, lv_item_type.

    LOOP AT it_decision_attr ASSIGNING <ls_dec>.
      ASSIGN COMPONENT 'ACTIVE' OF STRUCTURE <ls_dec> TO <fs_val>.
      IF sy-subrc = 0 AND <fs_val> IS ASSIGNED AND <fs_val> = 'X'.

        ASSIGN COMPONENT 'PHASE_ID' OF STRUCTURE <ls_dec> TO <fs_val>.
        IF sy-subrc = 0 AND <fs_val> IS ASSIGNED.
          lv_phase_id = <fs_val>.
        ENDIF.

        ASSIGN COMPONENT 'PHASE_TEXT' OF STRUCTURE <ls_dec> TO <fs_val>.
        IF sy-subrc = 0 AND <fs_val> IS ASSIGNED.
          lv_phase_text = <fs_val>.
        ENDIF.

        ASSIGN COMPONENT 'ITEM_TYPE' OF STRUCTURE <ls_dec> TO <fs_val>.
        IF sy-subrc = 0 AND <fs_val> IS ASSIGNED.
          lv_item_type = <fs_val>.
        ENDIF.

        EXIT. " active row handled
      ENDIF.
    ENDLOOP.

    IF lv_phase_id IS INITIAL AND lv_phase_text IS INITIAL.
      READ TABLE it_decision_attr ASSIGNING <ls_dec> INDEX 1.
      IF sy-subrc = 0.
        ASSIGN COMPONENT 'PHASE_ID' OF STRUCTURE <ls_dec> TO <fs_val>.
        IF sy-subrc = 0 AND <fs_val> IS ASSIGNED.
          lv_phase_id = <fs_val>.
        ENDIF.
        ASSIGN COMPONENT 'PHASE_TEXT' OF STRUCTURE <ls_dec> TO <fs_val>.
        IF sy-subrc = 0 AND <fs_val> IS ASSIGNED.
          lv_phase_text = <fs_val>.
        ENDIF.
        ASSIGN COMPONENT 'ITEM_TYPE' OF STRUCTURE <ls_dec> TO <fs_val>.
        IF sy-subrc = 0 AND <fs_val> IS ASSIGNED.
          lv_item_type = <fs_val>.
        ENDIF.
      ENDIF.
    ENDIF.

    "----------------------------------------------------------------------
    " 4) Map LAISO (IV_LANGUAGE) -> 1-char SPRAS (for /RPM/PHASE_T-LANGU)
    "----------------------------------------------------------------------
    CLEAR lv_spras.
    IF iv_language IS NOT INITIAL.
*      SELECT SINGLE spras
*        FROM t002
*        INTO lv_spras
*       WHERE laiso = iv_language.
      SELECT SINGLE spras
        FROM v_t002_laiso
        INTO lv_spras
       WHERE laiso = iv_language.
    ENDIF.
    IF lv_spras IS INITIAL.
      lv_spras = sy-langu.
    ENDIF.

    "----------------------------------------------------------------------
    " 5) If PHASE_TEXT is empty, read from /RPM/PHASE_T with your keys
    "----------------------------------------------------------------------
    IF lv_phase_text IS INITIAL AND lv_phase_id IS NOT INITIAL.
      IF lv_item_type IS INITIAL.
        " Item type not passed; read by PHASE_ID + LANGU
        SELECT SINGLE phase_text
          FROM /rpm/phase_t
          INTO lv_phase_text
         WHERE phase_id = lv_phase_id
           AND langu    = lv_spras.
        IF sy-subrc <> 0 OR lv_phase_text IS INITIAL.
          SELECT SINGLE phase_text
            FROM /rpm/phase_t
            INTO lv_phase_text
           WHERE phase_id = lv_phase_id
             AND langu    = 'E'.
        ENDIF.
      ELSE.
        " Full key read: PHASE_ID + ITEM_TYPE + LANGU
        SELECT SINGLE phase_text
          FROM /rpm/phase_t
          INTO lv_phase_text
         WHERE phase_id  = lv_phase_id
           AND item_type = lv_item_type
           AND langu     = lv_spras.
        IF sy-subrc <> 0 OR lv_phase_text IS INITIAL.
          SELECT SINGLE phase_text
            FROM /rpm/phase_t
            INTO lv_phase_text
           WHERE phase_id  = lv_phase_id
             AND item_type = lv_item_type
             AND langu     = 'E'.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lv_phase_text IS INITIAL.
      RETURN. " cannot map phase → no snapshot
    ENDIF.

    "----------------------------------------------------------------------
    " 6) Segment 2 from PHASE_TEXT
    "----------------------------------------------------------------------
    DATA lv_phase_up TYPE string.
    lv_phase_up = lv_phase_text.
    TRANSLATE lv_phase_up TO UPPER CASE.

    CLEAR lv_seg2.
    IF lv_phase_up CS 'DETAILED IDEATION'.
      lv_seg2 = 'DI'.
    ELSEIF lv_phase_up CS 'PRE-FEASIBILITY'.
      lv_seg2 = 'PF'.
    ELSEIF lv_phase_up CS 'FEASIBILITY'.
      lv_seg2 = 'FE'.
    ELSEIF lv_phase_up CS 'EXECUTION'.
      lv_seg2 = 'EX'.
    ELSEIF lv_phase_up CS 'CLOSURE'.
      lv_seg2 = 'CL'.
    ELSEIF lv_phase_up CS 'COMPLETION'.
      lv_seg2 = 'CM'.
    ELSE.
      RETURN. " unmapped → skip
    ENDIF.

    "----------------------------------------------------------------------
    " 7) Build Version Info ID and Name
    "     ID:  DP-<Seg2>-<Seg3>-YYYY.MM.DD_HH:MM
    "     Name: 'Snapshot <PHASE_TEXT> Approved'  (per your requirement)
    "----------------------------------------------------------------------
    CLEAR: lv_date_c, lv_time_c, lv_ts, lv_ver_info_id, lv_ver_info_name.

    CONCATENATE sy-datum+0(4) '.' sy-datum+4(2) '.' sy-datum+6(2) INTO lv_date_c.
    CONCATENATE sy-uzeit+0(2) ':' sy-uzeit+2(2) INTO lv_time_c.
    CONCATENATE lv_date_c '_' lv_time_c INTO lv_ts.

    CONCATENATE 'DP-' lv_seg2 '-' lv_seg3 '-' lv_ts INTO lv_ver_info_id.
    CONCATENATE 'Snapshot ' lv_phase_text ' Approved' INTO lv_ver_info_name.

    "----------------------------------------------------------------------
    " 8) Create Snapshot (no COMMIT WORK here)
    "----------------------------------------------------------------------
    DATA: lv_version_guid TYPE crmt_object_guid,
          lv_ev_rc        TYPE i,
          lt_messages     TYPE /rpm/tt_messages.


*  CALL FUNCTION '/RPM/ITEMS_VERS_CREATE'
*    EXPORTING
*      iv_item_guid         = lv_item_guid
*      iv_version_info_id   = lv_ver_info_id
*      iv_version_info_name = lv_ver_info_name
*    IMPORTING
*      ev_version_guid      = lv_version_guid
*    EXCEPTIONS
*      failed               = 1
*      OTHERS               = 2.
    ls_item_guid-guid = lv_item_guid.
    APPEND ls_item_guid TO lt_item_guids.

    " IMPORTANT: set to your IMG value (typically '01')
    lv_version_type = '01'.

    lv_hdr_name = lv_ver_info_id.
    lv_cp_name  = lv_ver_info_name.

    CALL FUNCTION '/RPM/ITEMS_VERS_CREATE'
      EXPORTING
        it_item_guids      = lt_item_guids
        iv_version_type    = lv_version_type
        iv_vers_hdr_name   = lv_hdr_name
        iv_cp_version_name = lv_cp_name
        iv_log_messages    = abap_true
      IMPORTING
        ev_rc              = lv_ev_rc
        et_messages        = lt_messages.

    IF lv_ev_rc IS NOT INITIAL.
      " Optional: map lt_messages to your UI messages if desired
      RETURN.
    ENDIF.

    "If creation fails we simply return; framework controls LUW and messages.
  ENDMETHOD.


