  METHOD /rpm/if_ex_item_api~item_ui_config_modify.
    DATA : lt_dd03p TYPE TABLE OF dd03p.
    IF is_item_attributes IS NOT INITIAL.
      CALL METHOD zcl_ppm_custom_field_enhncmt=>item_check_with_parents
       EXPORTING
          im_item_attributes = is_item_attributes
        RECEIVING
          rt_dd03p           = lt_dd03p.

      LOOP AT ct_field_description ASSIGNING FIELD-SYMBOL(<fs_field_description>).
        IF line_exists( lt_dd03p[ fieldname = <fs_field_description>-fieldname ] ).
          <fs_field_description>-read_only = abap_true.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDMETHOD.


