*    ENDIF.
*    CONCATENATE 'Snapshot ' lv_phase_text ' Approved' INTO lv_ver_info_name.
*    TRANSLATE lv_ver_info_name TO UPPER CASE.
*    " If you want the **actual** status in the name use:
*    "* DATA lv_status_txt TYPE string.
*    "* IF lv_seg3 = 'APRV'.
*    "*   lv_status_txt = 'Approved'.
*    "* ELSEIF lv_seg3 = 'HOLD'.
*    "*   lv_status_txt = 'On Hold'.
*    "* ELSEIF lv_seg3 = 'DECL'.
*    "*   lv_status_txt = 'Declined'.
*    "* ENDIF.
*    "* CONCATENATE 'Snapshot ' lv_phase_text ' ' lv_status_txt INTO lv_ver_info_name.
*
*    "----------------------------------------------------------------------
*    " 5) Create the snapshot (no COMMIT WORK here; framework owns LUW)
*    "----------------------------------------------------------------------
*
**    TYPES: BEGIN OF ty_item_guid,
**             guid TYPE /rpm/tv_guid,
**           END OF ty_item_guid.
*    DATA: lt_item_guid    TYPE /rpm/tt_guid,
*          ls_item_guid    TYPE /rpm/ts_guid,
*          lv_guid         TYPE /rpm/tv_guid,
*          lv_version_guid TYPE crmt_object_guid,
*          lv_ev_rc        TYPE i,
*          lt_messages     TYPE /rpm/tt_messages.
*
*    CONSTANTS: lv_version_type TYPE inm_tv_version_type VALUE '01'.
*    CLEAR: lt_item_guid, ls_item_guid.
*    " Table of item GUIDs
*
*
*
*    ls_item_guid-guid = lv_item_guid.
*    APPEND ls_item_guid TO lt_item_guid.
*
*    CALL FUNCTION '/RPM/ITEMS_VERS_CREATE'
*      EXPORTING
*        it_item_guids    = lt_item_guid
*        iv_version_type  = lv_version_type
*        iv_vers_hdr_name = lv_ver_info_name
**       iv_cp_version_name = lv_ver_info_id
**       iv_vers_hdr_description =
**       iv_versioned_parent     =
**       iv_laiso         =
**       iv_log_messages  = abap_false
*      IMPORTING
*       ev_rc            = lv_ev_rc
*       et_messages      = lt_messages
*      .
**End of changes for the RICEF 9331 by 116599
  ENDMETHOD.


