    "----------------------------------------------------------------------
    " Create PPM Item Snapshot when a Decision row in IT_DECISIONS
    " has STATUS ZDP06 (Approved) / ZDP04 (On Hold) / ZDP05 (Declined).
    " - Uses decision STATUS from IT_DECISIONS (not /RPM/ITEM_D)
    " - Maps Segment-2 from DECISION_ID, fallback by text
    " - Builds Version ID/Name; upper-cases Name before FM call
    " - Prevents duplicates via /RPM/IT_VER_CTRL
    " - Memory-ID reentry guard uses CHAR-like ID (not STRING)
    " - FM /RPM/ITEMS_VERS_CREATE called with *only* mandatory params + ID/Name
    "----------------------------------------------------------------------

    "---- Decision UI data -------------------------------------------------
    DATA: lv_item_guid   TYPE /rpm/item_d-guid,   " RAW16 (GUID)
          lv_decision_id TYPE string,
          lv_phase_text  TYPE string,
          lv_dec_status  TYPE string,            " decision STATUS (ZDP06/04/05)
          lv_seg2        TYPE c LENGTH 2,
          lv_seg3        TYPE c LENGTH 4.

    "---- Version ID/Name build -------------------------------------------
    DATA: lv_date_c(10),
          lv_time_c(5),
          lv_ts            TYPE string,
          lv_ver_info_id   TYPE string,            " header name (ID)
          lv_ver_info_name TYPE string,            " display name (Name)
          lv_guide         TYPE rpm_tv_guid,
          lv_guide_itm     TYPE rpm_tv_guid.
    FIELD-SYMBOLS: <ls_dec> TYPE any,
                   <fv>     TYPE any.

*  CLEAR ev_rc.

    "----------------------------------------------------------------------
    " 1) Extract: GUID / DECISION_ID / NAME|PHASE_TEXT / STATUS from IT_DECISIONS
    "    Prefer ACTIVE='X' row; fallback to first row.
    "----------------------------------------------------------------------
    CLEAR: lv_item_guid, lv_decision_id, lv_phase_text, lv_dec_status,lv_guide,lv_guide_itm.

    LOOP AT it_decisions ASSIGNING <ls_dec>.
      ASSIGN COMPONENT 'ACTIVE' OF STRUCTURE <ls_dec> TO <fv>.
      IF sy-subrc = 0 AND <fv> IS ASSIGNED AND <fv> = 'X'.
        ASSIGN COMPONENT 'ITEM_GUID' OF STRUCTURE <ls_dec> TO <fv>.
        IF sy-subrc = 0 AND <fv> IS ASSIGNED AND <fv> IS NOT INITIAL.
          lv_item_guid = <fv>.
        ELSE.
          ASSIGN COMPONENT 'GUID' OF STRUCTURE <ls_dec> TO <fv>.
          IF sy-subrc = 0 AND <fv> IS ASSIGNED AND <fv> IS NOT INITIAL.
            lv_item_guid = <fv>.
          ENDIF.
        ENDIF.

        ASSIGN COMPONENT 'DECISION_ID' OF STRUCTURE <ls_dec> TO <fv>.
        IF sy-subrc = 0 AND <fv> IS ASSIGNED.
          lv_decision_id = <fv>.
        ENDIF.

        ASSIGN COMPONENT 'PHASE_TEXT' OF STRUCTURE <ls_dec> TO <fv>.
        IF sy-subrc = 0 AND <fv> IS ASSIGNED AND <fv> IS NOT INITIAL.
          lv_phase_text = <fv>.
        ELSE.
          ASSIGN COMPONENT 'NAME' OF STRUCTURE <ls_dec> TO <fv>.
          IF sy-subrc = 0 AND <fv> IS ASSIGNED.
            lv_phase_text = <fv>.
          ENDIF.
        ENDIF.
        "----------------------------------------------------------------------
        ASSIGN COMPONENT 'GUID' OF STRUCTURE <ls_dec> TO <fv>.
        IF sy-subrc = 0 AND <fv> IS ASSIGNED AND <fv> IS NOT INITIAL.
          lv_guide = <fv>.
        ENDIF.
        ASSIGN COMPONENT 'ITEM_GUID' OF STRUCTURE <ls_dec> TO <fv>.
        IF sy-subrc = 0 AND <fv> IS ASSIGNED AND <fv> IS NOT INITIAL.
          lv_guide_itm = <fv>.
        ENDIF.
        "----------------------------------------------------------------------

        ASSIGN COMPONENT 'STATUS' OF STRUCTURE <ls_dec> TO <fv>.
        IF sy-subrc = 0 AND <fv> IS ASSIGNED.
          lv_dec_status = <fv>.
        ENDIF.
        EXIT.
      ENDIF.
    ENDLOOP.

    IF lv_item_guid IS INITIAL OR lv_decision_id IS INITIAL OR lv_dec_status IS INITIAL.
      READ TABLE it_decisions ASSIGNING <ls_dec> INDEX 1.
      IF sy-subrc = 0.
        ASSIGN COMPONENT 'ITEM_GUID' OF STRUCTURE <ls_dec> TO <fv>.
        IF sy-subrc = 0 AND <fv> IS ASSIGNED AND <fv> IS NOT INITIAL.
          lv_item_guid = <fv>.
        ELSE.
          ASSIGN COMPONENT 'GUID' OF STRUCTURE <ls_dec> TO <fv>.
          IF sy-subrc = 0 AND <fv> IS ASSIGNED AND <fv> IS NOT INITIAL.
            lv_item_guid = <fv>.
          ENDIF.
        ENDIF.
        ASSIGN COMPONENT 'DECISION_ID' OF STRUCTURE <ls_dec> TO <fv>.
        IF sy-subrc = 0 AND <fv> IS ASSIGNED.
          lv_decision_id = <fv>.
        ENDIF.
        ASSIGN COMPONENT 'PHASE_TEXT' OF STRUCTURE <ls_dec> TO <fv>.
        IF sy-subrc = 0 AND <fv> IS ASSIGNED AND <fv> IS NOT INITIAL.
          lv_phase_text = <fv>.
        ELSE.
          ASSIGN COMPONENT 'NAME' OF STRUCTURE <ls_dec> TO <fv>.
          IF sy-subrc = 0 AND <fv> IS ASSIGNED.
            lv_phase_text = <fv>.
          ENDIF.
        ENDIF.
        ASSIGN COMPONENT 'STATUS' OF STRUCTURE <ls_dec> TO <fv>.
        IF sy-subrc = 0 AND <fv> IS ASSIGNED.
          lv_dec_status = <fv>.
        ENDIF.
      ENDIF.
    ENDIF.

    IF lv_item_guid IS INITIAL OR lv_decision_id IS INITIAL OR lv_dec_status IS INITIAL.
      RETURN.
    ENDIF.

    "----------------------------------------------------------------------
    "  decision STATUS Existing Check
    "----------------------------------------------------------------------
    DATA : lv_old_status TYPE /rpm/tv_status_common.
    CLEAR: lv_old_status.
    SELECT SINGLE status
      FROM /rpm/decision
     WHERE ( guid = @lv_guide
      AND decision_id = @lv_decision_id )
      OR ( decision_id = @lv_decision_id
       AND item_guid = @lv_guide_itm )
      INTO @lv_old_status.

*    --------------------------------------------------------------------
*     No status change = no version creation
*    --------------------------------------------------------------------

    IF lv_old_status = lv_dec_status.
      RETURN.
    ENDIF.

    "----------------------------------------------------------------------
    " 2) Segment‑3 from decision STATUS
    "----------------------------------------------------------------------
    CLEAR lv_seg3.
    CASE lv_dec_status.
      WHEN 'ZDP04'. lv_seg3 = 'HOLD'.
      WHEN 'ZDP05'. lv_seg3 = 'DECL'.
      WHEN 'ZDP06'. lv_seg3 = 'APRV'.
      WHEN OTHERS.  RETURN.
    ENDCASE.

    "----------------------------------------------------------------------
    " 3) Segment‑2 from DECISION_ID; fallback by phase text
    "----------------------------------------------------------------------
    CLEAR lv_seg2.
    CASE lv_decision_id.
      WHEN 'Z_DP_10'. lv_seg2 = 'DI'.
      WHEN 'Z_DP_20'. lv_seg2 = 'PF'.
      WHEN 'Z_DP_30'. lv_seg2 = 'FE'.
      WHEN 'Z_DP_40'. lv_seg2 = 'EX'.
      WHEN 'Z_DP_50'. lv_seg2 = 'CL'.
      WHEN 'Z_DP_60'. lv_seg2 = 'CM'.
    ENDCASE.

    IF lv_seg2 IS INITIAL AND lv_phase_text IS NOT INITIAL.
      DATA lv_phase_up TYPE string.
      lv_phase_up = lv_phase_text.
      TRANSLATE lv_phase_up TO UPPER CASE.
      IF lv_phase_up CS 'IDEATION'.
        lv_seg2 = 'DI'.
      ELSEIF lv_phase_up CS 'PRE-FEASIBILITY'.
        lv_seg2 = 'PF'.
      ELSEIF lv_phase_up CS 'FEASIBILITY'.
        lv_seg2 = 'FE'.
      ELSEIF lv_phase_up CS 'EXECUTION'.
        lv_seg2 = 'EX'.
      ELSEIF lv_phase_up CS 'CLOSURE'.
        lv_seg2 = 'CL'.
      ELSEIF lv_phase_up CS 'COMPLETION'.
        lv_seg2 = 'CM'.
      ENDIF.
    ENDIF.

    IF lv_seg2 IS INITIAL.
      RETURN.
    ENDIF.

    "----------------------------------------------------------------------
    " 4) Build Version Info ID & Name (upper-case Name)
    "     ID:   DP-<Seg2>-<Seg3>-YYYY.MM.DD_HH:MM
    "     Name: Snapshot <PHASE_TEXT> Approved   (upper-cased)
    "----------------------------------------------------------------------
    CONCATENATE sy-datum+0(4) '.' sy-datum+4(2) '.' sy-datum+6(2) INTO lv_date_c.
    CONCATENATE sy-uzeit+0(2) ':' sy-uzeit+2(2) INTO lv_time_c.
    CONCATENATE lv_date_c '_' lv_time_c            INTO lv_ts.

    CONCATENATE 'DP-' lv_seg2 '-' lv_seg3 '-' lv_ts INTO lv_ver_info_id.

    IF lv_phase_text IS INITIAL.
      lv_phase_text = lv_decision_id.
    ENDIF.

    CONCATENATE 'Snapshot ' lv_phase_text ' Approved' INTO lv_ver_info_name.
    TRANSLATE lv_ver_info_name TO UPPER CASE.  " upper-case the Name

    "----------------------------------------------------------------------
    " 5) Re-entry guard (CHAR-like memory ID; STRING not allowed)
    "----------------------------------------------------------------------
    DATA: lv_memid TYPE c LENGTH 64,   " << fix: char-like, not string
          ls_mem   TYPE string.

    lv_memid = |Z_RPM_SNAP_{ lv_item_guid }|.
    IMPORT ls_mem = ls_mem FROM MEMORY ID lv_memid.
    IF ls_mem = lv_ver_info_id.
      RETURN. " already processed in this LUW
    ENDIF.

    "----------------------------------------------------------------------
    " 6) Duplicate prevention via /RPM/IT_VER_CTRL (no /RPM/S_ITEM_VERSION)
    "----------------------------------------------------------------------
    DATA lv_exists TYPE abap_bool VALUE abap_false.

    SELECT SINGLE name
      FROM /rpm/it_ver_ctrl
      WHERE guid = @lv_item_guid
        AND name = @lv_ver_info_name
      INTO @DATA(lv_dummy_vers_hdr).
    IF sy-subrc = 0.
      lv_exists = abap_true.
    ENDIF.

    IF lv_exists = abap_true.
      ls_mem = lv_ver_info_id.
      EXPORT ls_mem = ls_mem TO MEMORY ID lv_memid.
      RETURN.
    ENDIF.

    "----------------------------------------------------------------------
    " 7) Build IT_ITEM_GUIDS (Unicode-safe: row type is /RPM/TS_GUID with field GUID)
    "    and call FM with only mandatory params + ID/Name
    "----------------------------------------------------------------------
    DATA: lt_item_guids   TYPE /rpm/tt_guid,
          ls_item_guid    TYPE /rpm/ts_guid,
          lv_version_type TYPE inm_tv_version_type,   " use your domain code (e.g., '01')
          lv_hdr_name     TYPE /rpm/tv_version_name,  " header name (ID)
          lv_cp_name      TYPE /rpm/tv_version_name,  " display name (upper-cased)
          lv_ev_rc        TYPE i,
          lt_messages     TYPE /rpm/tt_messages.

    CLEAR: lt_item_guids, ls_item_guid, lv_version_type, lv_hdr_name, lv_cp_name,
           lv_ev_rc, lt_messages.

    ls_item_guid-guid = lv_item_guid.
    APPEND ls_item_guid TO lt_item_guids.

    " IMPORTANT: set to your IMG value (typically '01')
    lv_version_type = '01'.

    lv_hdr_name = lv_ver_info_id.
    lv_cp_name  = lv_ver_info_name.

    CALL FUNCTION '/RPM/ITEMS_VERS_CREATE'
      EXPORTING
        it_item_guids      = lt_item_guids
        iv_version_type    = lv_version_type
        iv_vers_hdr_name   = lv_hdr_name
        iv_cp_version_name = lv_cp_name
        iv_log_messages    = abap_true
      IMPORTING
        ev_rc              = lv_ev_rc
        et_messages        = lt_messages.

    " Mark as processed this LUW to avoid re-entry
    ls_mem = lv_ver_info_id.
    EXPORT ls_mem = ls_mem TO MEMORY ID lv_memid.

    IF lv_ev_rc IS NOT INITIAL.
      " Optional: map lt_messages to your UI messages if desired
      RETURN.
    ENDIF.




