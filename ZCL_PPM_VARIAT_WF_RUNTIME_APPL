CLASS ZCL_PPM_VARIAT_WF_RUNTIME_APPL IMPLEMENTATION.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_PPM_VARIAT_WF_RUNTIME_APPL->IF_SWF_FLEX_IFS_RUN_APPL_STEP~AFTER_COMPLETION_CALLBACK
* +-------------------------------------------------------------------------------------------------+
* | [--->] IO_CONTEXT                     TYPE REF TO IF_SWF_FLEX_RUN_CONTEXT
* | [--->] IO_CURRENT_ACTIVITY            TYPE REF TO IF_SWF_FLEX_IFS_RUN_ACTIVITY
* | [--->] IV_DEFAULT_ADHOC_STEP_ID       TYPE        STRING
* | [--->] IV_DEFAULT_ACTION              TYPE        STRING
* | [<---] EV_IGNORE_ADHOC_STEP           TYPE        ABAP_BOOL
* | [<---] EV_ACTION                      TYPE        STRING
* | [<---] EV_ACTION_PARAM                TYPE        STRING
* | [!CX!] CX_SWF_FLEX_IFS_RUN_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_swf_flex_ifs_run_appl_step~after_completion_callback.

    DATA: lv_default_action    TYPE string.
    DATA: lo_root_component TYPE REF TO if_swf_flex_ifs_inst_block.
    DATA: lv_agent             TYPE wfsyst-act_agent.
    DATA: lv_last_step_action  TYPE string.
    DATA: lv_Decision_WI_Result TYPE swd_lines-returncode,
          lv_wfinst_main        TYPE rpm_tv_guid,
          lv_wfinst_main_new        TYPE rpm_tv_guid.

    DATA: lv_ppm_item  	       TYPE /rpm/tv_extid,
          lv_variation_number  TYPE qmnum,
          lv_stepnumber        TYPE zwrkflow_seq1,
          lv_variation_type    TYPE qmart,
          lv_status	           TYPE numc5,
          lv_workflow_action   TYPE zwrkflow_act,
          lv_govern_role       TYPE zdp_gov_role,
          lv_holder_summary	   TYPE fincs_long_text_250,
          lv_processed_by	     TYPE edoc_it_pec_email_address,
          lv_local_created_by	 TYPE swp_agent,
          lv_workitemid	       TYPE sww_wiid,
          "lv_decision_wi_result  TYPE swd_retur_ ,
          lv_lastlevelapproval TYPE boole_d,
          lv_pmapprover	       TYPE swp_agent,
          ls_variationhead     TYPE /noveco/var_head,
          lv_deep_link_url     TYPE tsftext,
          lv_wf_path           TYPE zde_apprv_path.

    DATA: lo_workitem TYPE REF TO bi_object.

    ev_action = if_swf_flex_ifs_run_appl_step=>c_action_default.

    TEST-SEAM workflow_container.
      TRY.
          DATA(lo_workflow_container) = io_context->get_workflow_container( ).
          lo_workflow_container->get( EXPORTING name = 'Decision_WI_Result'  IMPORTING value = lv_Decision_WI_Result ).
        CATCH cx_swf_cnt_container.
          " Handle exception if element is missing
      ENDTRY.
    END-TEST-SEAM.
    DATA(lv_workflowsteptype) = io_current_activity->get_reference_id( ).
    DATA(lv_execution_results) = io_current_activity->get_execution_results( ).
    IF lv_workflowsteptype IS NOT INITIAL.
      TRY.
          DATA(lv_nodeid) = mo_definition->get_nodeid_via_id( lv_workflowsteptype ).

          IF lv_nodeid = 36." Rework task , when click on re-submit in my inbox
            IF lv_Decision_WI_Result = zif_ppm_variation_wf_c=>c_decision_outcome_id-approve.
              lv_Decision_WI_Result = zif_ppm_variation_wf_c=>c_decision_outcome_id-resubmit.
            ENDIF.
          ENDIF.
        CATCH cx_swf_flex_run_def_exception INTO DATA(lx_exception).
*          RAISE EXCEPTION TYPE cx_swf_flex_run_def_exception
*            EXPORTING
*              previous = lx_exception.
      ENDTRY.
    ENDIF.
    IF ( ( iv_default_adhoc_step_id = 'Rework' AND iv_default_action EQ if_swf_flex_component=>c_action_restart )
      OR iv_default_action EQ if_swf_flex_component=>c_action_cancel OR lv_Decision_WI_Result = zif_ppm_variation_wf_c=>c_decision_outcome_id-resubmit  OR lv_nodeid = 36 )  .
      TRY.
          lo_workflow_container->get( EXPORTING name = 'WFINST_MAIN'  IMPORTING value = lv_wfinst_main ).
*          lv_ppm_item
          lo_workflow_container->get( EXPORTING name = 'PORTFOLIOITEM'  IMPORTING value = lv_ppm_item ).
*          lv_variation_number
          lo_workflow_container->get( EXPORTING name = 'VARIATIONNUMBER'  IMPORTING value = lv_variation_number ).
*          lv_stepnumber
          lo_workflow_container->get( EXPORTING name = 'STEPNUMBER'  IMPORTING value = lv_stepnumber  ).
*          lv_variation_type
          lo_workflow_container->get( EXPORTING name = 'VARIATION_TYPE'  IMPORTING value = lv_variation_type  ).
*          lv_workflow_action
          lo_workflow_container->get( EXPORTING name = 'CURR_WORKFLOW_ACTION'  IMPORTING value = lv_workflow_action  ).
*          lv_govern_role
*          lv_holder_summary
*          lv_processed_by
*          lv_local_created_by    - DECISION_ACTUAL_AGENT
          lo_workflow_container->get( EXPORTING name = 'DECISION_ACTUAL_AGENT'  IMPORTING value = lv_local_created_by ).
*          lv_workitemid    -   lo_Workitem
          " lo_workflow_container->get( EXPORTING name = '_Workitem'  IMPORTING value = lo_workitem ).
*          lv_decision_wi_result
*          lv_lastlevelapproval
          lo_workflow_container->get( EXPORTING name = 'ISLASTLEVELAPPROVAL'  IMPORTING value = lv_lastlevelapproval  ).
*          lv_pmapprover
          lo_workflow_container->get( EXPORTING name = 'PMAPPROVER'  IMPORTING value = lv_pmapprover ).
*          ls_variationhead
          lo_workflow_container->get( EXPORTING name = 'VARIATIONHEAD'  IMPORTING value = ls_variationhead  ).
*          lv_deep_link_url
          lo_workflow_container->get( EXPORTING name = 'DEEP_LINK_URL'  IMPORTING value = lv_deep_link_url  ).
*          lv_wfinst_main
          lo_workflow_container->get( EXPORTING name = 'WF_PATH'  IMPORTING value = lv_wf_path  ).

          TRY.
              lv_workitemid = io_context->get_wi_id( ).

            CATCH cx_swf_cnt_container.
              " Handle exception if element is missing
          ENDTRY.
*---------------------------------------------------------------------------------------*
*---------------------------------------------------------------------------------------*
*-->In case action result restart workflow is applicable.We need to refresh the container elements
          IF  iv_default_action EQ if_swf_flex_component=>c_action_restart OR iv_default_action EQ if_swf_flex_component=>c_action_cancel
            OR lv_Decision_WI_Result = zif_ppm_variation_wf_c=>c_decision_outcome_id-resubmit OR lv_nodeid = 36 .
            TRY.
                DATA(lo_cl_ppm_wf) = NEW zcl_ppm_variation_wf( ).
                DATA: lv_r_workflow_action      TYPE zwrkflow_act,
                      lv_r_stepnumber           TYPE zwrkflow_seq1,
                      lv_r_workflow_action_text TYPE char80,
                      lv_r_governancerole_text  TYPE char80,
                      lv_r_total_steps          TYPE mmpur_wf_current_approval_step.

                CALL METHOD lo_cl_ppm_wf->update_tracking_steps
                  EXPORTING
                    iv_ppm_item             = lv_ppm_item              " Portfolio Item
                    iv_variation_number     = lv_variation_number              " Notification Number
                    iv_stepnumber           = lv_stepnumber              " Var WF Sequence
                    iv_variation_type       = lv_variation_type              " Notification Type
*                   iv_status               =                  " 5 Character Numeric NUMC
                    iv_workflow_action      = lv_workflow_action              " Workflow Action
*                   iv_govern_role          =                  " Governance Role
*                   iv_holder_summary       =                  " Long Description
*                   iv_processed_by         =                  " PEC e-Mail Address of Invoice Recipient
                    iv_local_created_by     = lv_local_created_by             " Created By User
                    iv_workitemid           = lv_workitemid           " Work item ID
                    iv_decision_wi_result   = lv_decision_wi_result               " Workflow Definition: Container Expression for Step Result
                    iv_lastlevelapproval    = lv_lastlevelapproval                " Data element for domain BOOLE: TRUE (='X') and FALSE (=' ')
                    iv_pmapprover           = lv_pmapprover            " Agent
                    is_variationhead        = ls_variationhead           " EVM Variation List
                    iv_deep_link_url        = lv_deep_link_url               " URL
                    iv_wfinst_main          = lv_wfinst_main           " Guid for application objects
                    iv_wf_path              = lv_wf_path
                  IMPORTING
                    ev_result               = DATA(lv_result)                " Data element for domain BOOLE: TRUE (='X') and FALSE (=' ')
                  CHANGING
                    ev_workflow_action      = lv_r_workflow_action              " Workflow Action
                    ev_stepnumber           = lv_r_stepnumber                 " Var WF Sequence
                    ev_workflow_action_text = lv_r_workflow_action_text                 " Workflow Action text
                    ev_governancerole_text  = lv_r_governancerole_text                 " Governance role
                    ev_total_steps          = lv_r_total_steps                 " Current Approval Step
                    ev_wfinst_main          = lv_wfinst_main_new
                  EXCEPTIONS
                    save_data_failed        = 1                " Save data failed
                    OTHERS                  = 2.
                IF lv_Decision_WI_Result = zif_ppm_variation_wf_c=>c_decision_outcome_id-resubmit.
                    TRY.
                         lo_workflow_container->set( EXPORTING name = 'WFINST_MAIN' value = lv_wfinst_main_new ).

                    CATCH cx_swf_cnt_container.
                          " Handle exception if element is missing
                     ENDTRY.
                ENDIF.
              CATCH cx_swf_flex_ifs_run_exception INTO DATA(lx_run_wfl_exception). " Flexible Runtime Exception
                RAISE EXCEPTION TYPE cx_swf_flex_ifs_run_exception
                  EXPORTING
                    previous = lx_run_wfl_exception.
            ENDTRY.
          ENDIF.
        CATCH cx_swf_cnt_cont_access_denied
              cx_swf_cnt_elem_access_denied
              cx_swf_cnt_elem_not_found
              cx_swf_cnt_container.
      ENDTRY.
    ENDIF.


  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_PPM_VARIAT_WF_RUNTIME_APPL->IF_SWF_FLEX_IFS_RUN_APPL~ON_RESTART_CALLBACK
* +-------------------------------------------------------------------------------------------------+
* | [--->] IO_CONTEXT                     TYPE REF TO IF_SWF_FLEX_RUN_CONTEXT
* | [--->] IO_ROOT_COMPONENT              TYPE REF TO IF_SWF_FLEX_IFS_INST_BLOCK
* | [--->] IV_CONDITIONAL_RESTART         TYPE        ABAP_BOOL (default =ABAP_TRUE)
* | [!CX!] CX_SWF_FLEX_IFS_RUN_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD IF_SWF_FLEX_IFS_RUN_APPL~ON_RESTART_CALLBACK.
*------------------------------------------------------------------------------------*
*-->Clear the variable on Restart
*------------------------------------------------------------------------------------*
*--> Variables
    DATA: lv_last_StepNumber      TYPE numc3,
          lv_curr_workflow_action TYPE zwrkflow_act,
          LV_CURR_WORKFLOW_ACTION_TEXT TYPE CHAR80,
          LV_GOVENANCEROLE_TEXT TYPE CHAR80,
          LV_ISLAST_APPROVAL TYPE BOOLE_D.
    DATA: lv_wfinst_main    TYPE rpm_tv_guid,
          lv_chk_crt_wfinst TYPE boole_d,
          lv_step_uuid      TYPE rpm_tv_guid,
          lr_actions        TYPE RANGE OF zwrkflow_act,
          lsr_action        LIKE LINE OF lr_actions,
          lv_variation_type TYPE QMART,
          lv_portfolioitem TYPE /RPM/TV_EXTID.

*------------------------------------------------------------------------------------*
    TEST-SEAM container_object.
      DATA(lo_container) = io_context->get_workflow_container( ).
    END-TEST-SEAM.

    IF lo_container IS BOUND.
      Try.
* Get Variation type
*-->VARIATION_TYPE
          lo_container->get(
            EXPORTING
              name       = 'VARIATION_TYPE'
            IMPORTING
              value      = lv_variation_type
          ).

* Get portfolio item
*lv_iv_portfolioitem

          lo_container->get(
            EXPORTING
              name       = 'PORTFOLIOITEM'
            IMPORTING
              value      = lv_portfolioitem
          ).
    CATCH cx_swf_cnt_cont_access_denied. " Changed Access Not Allowed
        CATCH cx_swf_cnt_elem_access_denied. " Value/Unit Must Not Be Changed
        CATCH cx_swf_cnt_elem_not_found.     " Element Not in the Container
        CATCH cx_swf_cnt_elem_type_conflict. " Type Conflict Between Value and Current Parameter
        CATCH cx_swf_cnt_unit_type_conflict. " Type Conflict Between Unit and Current Parameter
        CATCH cx_swf_cnt_elem_def_invalid.   " Element Definition Is Invalid (Internal Error)
        CATCH cx_swf_cnt_container.          " Exception in the Container Service

      ENDTRY.
          lv_chk_crt_wfinst = abap_true.

*       Get the first step number instead of using the Iv_stepnumber.

          " Modern internal table population using VALUE operator with conditional logic
          lr_actions = VALUE #(
            sign   = 'I'
            option = 'EQ'
            ( low =  zif_ppm_variation_wf_c=>c_workflow_action-endorser )
            " The base sign/option carry over to subsequent rows if they aren't explicitly overridden
            ( low = zif_ppm_variation_wf_c=>c_workflow_action-approver_phase )
            ( low = zif_ppm_variation_wf_c=>c_workflow_action-approver_invest )
            "( low = zif_ppm_variation_wf_c=>c_workflow_action-decpnt_manager )
          ).

          IF lv_variation_type = 'Z4'."Internal

            DATA(lv_wf_path) = '01'.
            " read project role.
            SELECT portfolioitem,
              counter,
              positionid,
              rolename,
              roleposition,
              role,
              roleadditionalresponsible,
              decpointgovernancerole,
              workflowaction,
              workflowsequence,
              variationsequence
             FROM zi_ppm_projectroles
           WHERE portfolioitem = @lv_portfolioitem
            AND workflowaction IN @lr_actions
            AND positionid IS NOT INITIAL
            AND variationsequence IS NOT INITIAL
           ORDER BY variationsequence  ASCENDING
           INTO TABLE @DATA(lt_proj_roles).
            IF sy-subrc IS INITIAL.
              "DATA(lv_total_steps) = lines( lt_proj_roles ).
              DATA(ls_proj_roles) = VALUE #( lt_proj_roles[ 1 ]  OPTIONAL ).
              DATA(lv_step_number_first) =  ls_proj_roles-variationsequence.
              DATA(lv_workflow_seq_var)      = lv_step_number_first.
            ENDIF.
            DATA(lv_total_steps) = lines( lt_proj_roles ).
            " DATA(lv_wf_path) = '01'.
          ELSEIF lv_variation_type = 'Z1' OR lv_variation_type = 'Z2' OR lv_variation_type = 'R1'
          OR lv_variation_type = 'R2'."External
            SELECT portfolioitem,
                  counter,
                  positionid,
                  rolename,
                  roleposition,
                  role,
                  roleadditionalresponsible,
                  decpointgovernancerole,
                  workflowaction,
                  workflowsequence,
                  variationsequence
              FROM zi_ppm_projectroles
            WHERE portfolioitem = @lv_portfolioitem
              AND workflowaction IN @lr_actions
             AND positionid IS NOT INITIAL
             AND workflowsequence IS NOT INITIAL
            ORDER BY workflowsequence ASCENDING
              INTO TABLE @lt_proj_roles.
            IF sy-subrc IS INITIAL.
              "lv_total_steps = lines( lt_proj_roles ).
              ls_proj_roles = VALUE #( lt_proj_roles[ 1 ]  OPTIONAL ).
              lv_step_number_first =  ls_proj_roles-workflowsequence.
              DATA(lv_workflow_seq)      = lv_step_number_first.
            ENDIF.
            lv_total_steps = lines( lt_proj_roles ).
            lv_wf_path = '02'.
          ENDIF.

      TRY.
*-->StepNumber
          lo_container->get(
            EXPORTING
              name       = 'StepNumber'
            IMPORTING
              value      = lv_last_StepNumber
          ).

          lv_last_StepNumber = lv_step_number_first.
          lo_container->set(
            EXPORTING
              name       = 'StepNumber'
              value      = lv_step_number_first
          ).
*-->Fetch LV_CURR_WORKFLOW_ACTION
          lo_container->get(
            EXPORTING
              name       = 'CURR_WORKFLOW_ACTION'
            IMPORTING
              value      = lv_curr_workflow_action
          ).

           lv_curr_workflow_action = zif_ppm_variation_wf_c=>c_workflow_action-endorser.

          lo_container->set(
            EXPORTING
              name       = 'CURR_WORKFLOW_ACTION'
              value      = lv_curr_workflow_action
          ).

*--> CURR_WORKFLOW_ACTION_TEXT
          lo_container->get(
            EXPORTING
              name       = 'CURR_WORKFLOW_ACTION_TEXT'
              IMPORTING
              value      = LV_CURR_WORKFLOW_ACTION_TEXT  ).

*-->set CURR_WORKFLOW_ACTION_TEXT
          LV_CURR_WORKFLOW_ACTION_TEXT   = zif_ppm_variation_wf_c=>c_workflow_action_text-endorser.
          lo_container->set(
             EXPORTING name  = 'CURR_WORKFLOW_ACTION_TEXT'
                       value = LV_CURR_WORKFLOW_ACTION_TEXT ).

*-->Fecth LV_GOVENANCEROLE_TEXT - GOVERNANCEROLE_TEXT

          lo_container->get(
            EXPORTING
              name       = 'GOVERNANCEROLE_TEXT'
              IMPORTING
              value      = LV_GOVENANCEROLE_TEXT  ).

*-->Clear LV_GOVENANCEROLE_TEXT
          LV_GOVENANCEROLE_TEXT =  zif_ppm_variation_wf_c=>c_governance_role_action-pp_endorser.
          lo_container->set(
             EXPORTING name  = 'GOVERNANCEROLE_TEXT'
                       value = LV_GOVENANCEROLE_TEXT  ).

*-->Clear LV_ISLAST_APPROVAL
          lo_container->set(
            EXPORTING
              name       = 'ISLAST_APPROVAL'
              value      = LV_ISLAST_APPROVAL  ).

*-->Clear LV_ISLAST_APPROVAL
          CLEAR LV_ISLAST_APPROVAL.
          lo_container->set(
             EXPORTING name  = 'ISLAST_APPROVAL'
                       value = LV_ISLAST_APPROVAL  ).

        CATCH cx_swf_cnt_cont_access_denied. " Changed Access Not Allowed
        CATCH cx_swf_cnt_elem_access_denied. " Value/Unit Must Not Be Changed
        CATCH cx_swf_cnt_elem_not_found.     " Element Not in the Container
        CATCH cx_swf_cnt_elem_type_conflict. " Type Conflict Between Value and Current Parameter
        CATCH cx_swf_cnt_unit_type_conflict. " Type Conflict Between Unit and Current Parameter
        CATCH cx_swf_cnt_elem_def_invalid.   " Element Definition Is Invalid (Internal Error)
        CATCH cx_swf_cnt_container.          " Exception in the Container Service


      ENDTRY.
    ENDIF.


  ENDMETHOD.


* <SIGNATURE>---------------------------------------------------------------------------------------+
* | Instance Public Method ZCL_PPM_VARIAT_WF_RUNTIME_APPL->IF_SWF_FLEX_IFS_RUN_APPL_STEP~ON_DEADLINE_ACTION_CALLBACK
* +-------------------------------------------------------------------------------------------------+
* | [--->] IO_CONTEXT                     TYPE REF TO IF_SWF_FLEX_RUN_CONTEXT
* | [--->] IO_CURRENT_ACTIVITY            TYPE REF TO IF_SWF_FLEX_IFS_RUN_ACTIVITY
* | [--->] IV_TASK_WI_ID                  TYPE        SWW_WIID
* | [--->] IV_STEP_ID                     TYPE        STRING
* | [--->] IV_DEADLINE_ACTION_ID          TYPE        STRING
* | [--->] IO_LOG_HANDLE                  TYPE REF TO IF_SWF_FLEX_RUN_LOG
* | [!CX!] CX_SWF_FLEX_IFS_RUN_EXCEPTION
* +--------------------------------------------------------------------------------------</SIGNATURE>
  METHOD if_swf_flex_ifs_run_appl_step~on_deadline_action_callback.
    " Local variables

    DATA: lv_default_action    TYPE string.
    DATA: lo_root_component TYPE REF TO if_swf_flex_ifs_inst_block.
    DATA: lv_agent             TYPE wfsyst-act_agent.
    DATA: lv_last_step_action  TYPE string.
    DATA: lv_Decision_WI_Result TYPE swd_lines-returncode,
          lv_wfinst_main        TYPE rpm_tv_guid.
    DATA: lv_mail_address TYPE ad_smtpadr.
    DATA: lv_addname      TYPE ad_smtpadr.
    DATA: lv_address      TYPE REF TO cl_cam_address_bcs.
    DATA lv_emailid TYPE adr6-smtp_addr.
    DATA: lv_ppm_item  	       TYPE /rpm/tv_extid,
          lv_variation_number  TYPE qmnum,
          lv_stepnumber        TYPE zwrkflow_seq1,
          lv_variation_type    TYPE qmart,
          lv_status	           TYPE numc5,
          lv_workflow_action   TYPE zwrkflow_act,
          lv_govern_role       TYPE zdp_gov_role,
          lv_holder_summary	   TYPE fincs_long_text_250,
          lv_processed_by	     TYPE edoc_it_pec_email_address,
          lv_local_created_by	 TYPE abp_creation_user,
          lv_workitemid	       TYPE sww_wiid,
          "lv_decision_wi_result  TYPE swd_retur_ ,
          lv_lastlevelapproval TYPE boole_d,
          lv_pmapprover	       TYPE swp_agent,
          lv_curr_approver     TYPE swp_agent,
          ls_variationhead     TYPE /noveco/var_head,
          lv_deep_link_url     TYPE tsftext,
          lv_wf_path           TYPE zde_apprv_path,
          lo_bcs_exception     TYPE REF TO cx_bcs,
          lv_body_html         TYPE string,
          lv_subject           TYPE string.

    DATA: lo_workitem TYPE REF TO bi_object.
    DATA:
      "lo_send_request TYPE REF TO cl_bcs,
      lo_document TYPE REF TO cl_document_bcs,
      lo_sender   TYPE REF TO cl_sapuser_bcs.
     DATA: r_actions        TYPE RANGE OF zwrkflow_act,
        lsr_action       LIKE LINE OF r_actions.

    " 1. Execute standard/inherited deadline actions if any exist
    TRY.
        super->if_swf_flex_ifs_run_appl_step~on_deadline_action_callback(
          io_context           = io_context
          io_current_activity  = io_current_activity
          iv_task_wi_id        = iv_task_wi_id
          iv_step_id           = iv_step_id
          iv_deadline_action_id = iv_deadline_action_id
          io_log_handle        = io_log_handle
        ).
      CATCH cx_swf_flex_ifs_run_exception.
        " Clean catch or log if needed
    ENDTRY.


    TRY.
        DATA(lo_workflow_container) = io_context->get_workflow_container( ).
        lo_workflow_container->get( EXPORTING name = 'WF_PATH'  IMPORTING value = lv_wf_path  ).
*          lv_workflow_action
        lo_workflow_container->get( EXPORTING name = 'CURR_WORKFLOW_ACTION'  IMPORTING value = lv_workflow_action ).
        lo_workflow_container->get( EXPORTING name = 'VARIATIONNUMBER'  IMPORTING value = lv_variation_number ).
*          lv_stepnumber
        lo_workflow_container->get( EXPORTING name = 'STEPNUMBER'  IMPORTING value = lv_stepnumber  ).
        lo_workflow_container->get( EXPORTING name = 'WFINST_MAIN'  IMPORTING value = lv_wfinst_main ).
*          lv_ppm_item
        lo_workflow_container->get( EXPORTING name = 'PORTFOLIOITEM'  IMPORTING value = lv_ppm_item ).
*       CURR_APPROVER
        lo_workflow_container->get( EXPORTING name = 'CURR_APPROVER'  IMPORTING value = lv_curr_approver ).
      CATCH cx_swf_cnt_container.
        " Handle exception if element is missing
    ENDTRY.


    " 2. Handle your custom 'ReminderEmail' deadline action
    IF iv_deadline_action_id = 'ReminderEmail'.

      TRY.
          "-------------------------------------------------------------
          " STEP A: Retrieve Email Recipients (Task Agents)
          "-------------------------------------------------------------
          " Query standard tables to find active/assigned agents for the step
         SELECT portfolioitem,
                 counter,
                 positionid,
                 rolename,
                 roleposition,
                 role,
                 roleadditionalresponsible,
                 decpointgovernancerole,
                 workflowaction,
                 workflowsequence,
                 variationsequence
            FROM zi_ppm_projectroles
            WHERE portfolioitem = @lv_ppm_item
              AND workflowaction IN @r_actions
              AND positionid IS NOT INITIAL
            INTO TABLE @DATA(lt_positions).
          IF sy-subrc <> 0.
           " RAISE no_agent_next_approver_found.
            RETURN.
          ENDIF.
          IF sy-subrc IS INITIAL.
            IF lv_wf_path = zif_ppm_variation_wf_c=>c_workflow_type-internal."Internal
              SORT lt_positions BY variationsequence DESCENDING.
              DATA(ls_positions) = VALUE #( lt_positions[ variationsequence = lv_stepnumber  ] OPTIONAL ).
              "lv_current_step  = ls_variation_steps-WorkflowSeqVar.

            ELSEIF lv_wf_path  = zif_ppm_variation_wf_c=>c_workflow_type-external."External

              SORT lt_positions BY workflowsequence DESCENDING.

              ls_positions  = VALUE #( lt_positions[ workflowsequence = lv_stepnumber ] OPTIONAL ).
              "lv_current_step  = ls_variation_steps-WorkflowSeq.
            ENDIF.


            DATA lt_recipients  TYPE zppm_tt_variation_holder .
            SELECT COUNT( * )
              FROM I_HCMObject
              INTO @DATA(lv_pos_match_count)
              WHERE HCMPlanVersion = @zif_ppm_variation_wf_c=>c_plan_version_active AND
                    HCMObjectType = @zif_ppm_variation_wf_c=>c_type_position AND
                    HCMObjectID = @ls_positions-positionid AND
                    StartDate <= @sy-datum AND
                    EndDate >= @sy-datum.
            IF lv_pos_match_count > 0.
              " Validate position find and grab organizational assigned users
              IF ls_positions-positionid IS NOT INITIAL.
                SELECT userid, emailaddress, fullname
                 FROM zi_positionholder_dp WITH PRIVILEGED ACCESS
                 WHERE positionid = @ls_positions-positionid
                 INTO TABLE @DATA(lt_holders) UP TO 3 ROWS.
                IF sy-subrc = 0 AND lt_holders IS NOT INITIAL.
                  " Fill actor table with verified users using inline FOR loop
                  " CLEAR actor_tab.
                  LOOP AT lt_holders INTO DATA(ls_holder) WHERE userid IS NOT INITIAL.
                    " APPEND VALUE #( otype = 'US' objid = ls_holder-userid ) TO actor_tab.
                    APPEND VALUE #( userid = ls_holder-userid  email = ls_holder-emailaddress fullname =  ls_holder-fullname ) TO  lt_recipients .
                  ENDLOOP.
                ENDIF.
              ELSE.
                " RAISE no_agent_found.
              ENDIF.
            ELSE.
              "RAISE no_agent_found.
            ENDIF.
          ENDIF.


          "-------------------------------------------------------------
          " STEP B: Instantiate and Map Template using CDS Keys
          "-------------------------------------------------------------
          " 1. Create the persistent sending request (BCS)
          DATA(lo_bcs) = cl_bcs=>create_persistent( ).

          " 2. Get instance of your S/4HANA email template
          DATA(lo_email_api) = cl_smtg_email_api=>get_instance(
            iv_template_id = 'ZPPM_9000002_VARI_DEADLINE'
          ).

          " 3. Supply the primary key of your CDS View (WorkflowTaskInternalID)
          DATA(lt_cds_key) = VALUE if_smtg_email_template=>ty_gt_data_key(
            ( name  = 'WORKFLOWTASKINTERNALID'
              value = iv_task_wi_id )
          ).

          " 3. Explicitly render the HTML Body and Subject from the CDS record

          " If HTML body is empty, try falling back to standard render
          "IF lv_body_html IS INITIAL.
          lo_email_api->render(
            EXPORTING
              iv_language         = sy-langu
              iv_language_default = 'E'
              it_data_key         = lt_cds_key
            IMPORTING
              ev_subject          = lv_subject
              ev_body_html        = lv_body_html
          ).
          " ENDIF.

          "-------------------------------------------------------------
          " STEP C: Configure Sender & Receivers and Send
          "-------------------------------------------------------------
          "  2. Convert the rendered HTML string to SOLI table format
          DATA(lt_soli_body) = cl_bcs_convert=>string_to_soli( lv_body_html ).

          " 3. Create document explicitly specifying 'HTM' (HTML Format)
          lo_document = cl_document_bcs=>create_document(
            i_type    = 'HTM'
            i_subject = CONV #( lv_subject )
            i_text    = lt_soli_body
          ).
          lo_bcs->set_document( lo_document ).

          " 4. Set System User as sender
          DATA:
         lv_default_addr TYPE smail_df_sender_addr.
          TRY.
              " Call the instance creation method present in your class signature
              DATA(lo_mail_config) = cl_bcs_mail_system_config=>create_instance( ).

              " Retrieve the default system sender configuration (replaces SOPR query)
              lo_mail_config->read_default_sender_address(
                IMPORTING
                  ev_default_sender_address = lv_default_addr
              ).

            CATCH cx_root. " Catching configuration fetch failures safely
          ENDTRY.

          " Fallback: If your system's default sender address is fully qualified (e.g. 'do-not-reply@domain.com')
          " extract the domain, or fallback to your system id if empty.
          IF lv_default_addr IS NOT INITIAL.
            IF lv_default_addr CS '@'.
              SPLIT lv_default_addr AT '@' INTO DATA(lv_user) DATA(lv_domain).
            ELSE.
              lv_domain = lv_default_addr.
            ENDIF.
          ENDIF.

          " Construct the clean core sender address layout safely
          IF lv_domain IS NOT INITIAL.
            lv_mail_address = |SAP_WFRT@{ lv_domain }|.
            lv_addname      = 'Workflow System'(025).

            TRY.
                CALL METHOD cl_cam_address_bcs=>create_internet_address
                  EXPORTING
                    i_address_string = lv_mail_address
                    i_address_name   = lv_addname
*                   i_incl_sapuser   =
                  RECEIVING
                    result           = lv_address.
              CATCH cx_address_bcs .
            ENDTRY.
*          ENDIF.
          ENDIF.
*          TRY.
**    -- Create persistent send request
*              lo_send_request = cl_bcs=>create_persistent( ).
*            CATCH cx_bcs INTO lo_bcs_exception.
*          ENDTRY.
*    -- Set sender
*          l_sender = cl_sapuser_bcs=>create( sy-uname ).
          CALL METHOD lo_bcs->set_sender
            EXPORTING
              i_sender = lv_address. "l_sender.


          " 2. Add email recipients
          LOOP AT lt_recipients INTO DATA(lv_recipient_mail).
            lv_emailid = lv_recipient_mail-email.
            DATA(lo_recipient) = cl_cam_address_bcs=>create_internet_address( lv_emailid  ).
            lo_bcs->add_recipient( i_recipient = lo_recipient ).
          ENDLOOP.

          " 3. Send email to queue
          lo_bcs->send( ).

          COMMIT WORK AND WAIT.                        "Commit Work
        CATCH cx_document_bcs.
        CATCH cx_smtg_email_common.
          " Handle S/4HANA email template exceptions
        CATCH cx_send_req_bcs.
          " Handle BCS mail framework exceptions
        CATCH cx_address_bcs.
          " Handle email parsing exceptions
      ENDTRY.

    ENDIF.
  ENDMETHOD.
ENDCLASS.
