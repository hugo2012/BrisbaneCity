  METHOD if_ex_iwon_notification~extensionout_notif.
*----------------------------------------------------------------------*
*Created by: Huy Tran - 117001
*TEAM : TAMS
*----------------------------------------------------------------------*
* Purpose:  Trigger Variation Workflow.
* Description: Check User status update Enhancement
* Reason:  Trigger SAP Variation workflow
* TR: D41K906343
*----------------------------------------------------------------------*
    DATA: lv_user_status_code TYPE usrsts.
    DATA: lv_pspid    TYPE /rpm/tv_extid.
    DATA: lv_wf_triggered TYPE abap_bool.
    "DATA: gs_qmel TYPE /noveco/evm_qmel.
    FIELD-SYMBOLS: <fs_status> TYPE any,
                   <fs_qmel>   TYPE any.
    DATA: ls_qmel          TYPE /noveco/evm_qmel,
          ls_variationhead TYPE /noveco/var_head.

    IF sy-tcode = '/NOVECO/EVM'.
      ASSIGN ('(/NOVECO/EVM_WORKBENCH)GS_QMEL-USER_STATUS_CODE') TO <fs_status>.
      ASSIGN ('(/NOVECO/EVM_WORKBENCH)GS_QMEL') TO <fs_qmel> .
      IF <fs_status> IS ASSIGNED AND <fs_status> IS NOT INITIAL AND <fs_qmel> IS ASSIGNED AND <fs_qmel> IS NOT INITIAL.
        ls_qmel = <fs_qmel>.
        lv_user_status_code = <fs_status>.
        IF lv_user_status_code EQ zif_ppm_variation_wf_c=>gc_user_status_pending
          OR lv_user_status_code EQ zif_ppm_variation_wf_c=>gc_user_status_active
          OR  lv_user_status_code EQ zif_ppm_variation_wf_c=>gc_user_status_approved.
          IF ls_qmel IS NOT INITIAL.
            " 1. Check if the flag was already set in memory for this notification/object
            IMPORT lv_wf_triggered = lv_wf_triggered
              FROM MEMORY ID 'ZPPM_WF_TRIGGERED'.
            IF lv_wf_triggered = abap_true.
              FREE MEMORY ID 'ZPPM_WF_TRIGGERED'.
            ENDIF.
            "Show the error message to prevent from submitt approval many times during the approval process.
            " Check the current status.
            CALL FUNCTION 'CONVERSION_EXIT_ABPSN_OUTPUT'
              EXPORTING
                input  = ls_qmel-pspid
              IMPORTING
                output = lv_pspid.
            "read the portfolio item details for parent bucket and portfolio UUIDs
            SELECT SINGLE ProjectPortfolioUUID,
                          ProjectPortfolioItemUUID,
                          ProjPrtfloItemParentObjectUUID,
                           ProjectPortfolioItem
              FROM ZI_ProjectPortfolioItemBasic WITH PRIVILEGED ACCESS
             WHERE ProjectPortfolioItem = @lv_pspid
             INTO @DATA(ls_portfolio_item).
            IF sy-subrc IS INITIAL.
              DATA(lv_item_guid)  = ls_portfolio_item-ProjectPortfolioItemUUID.
            ENDIF.

            SELECT status FROM zi_ppm_variat_appr WITH PRIVILEGED ACCESS "#EC CI_ALL_FIELDS_NEEDED
            WHERE itemguid = @ls_portfolio_item-projectportfolioitemuuid
              AND variation_number = @ls_qmel-qmnum
              AND status IN ( @zif_ppm_variation_wf_c=>c_flow_status-in_progress , @zif_ppm_variation_wf_c=>c_flow_status-approved )
              ORDER BY LocalCreatedAt DESCENDING
             INTO TABLE @DATA(lt_variat_appr_stat)
              UP TO 1 ROWS.
            IF sy-subrc IS INITIAL.
              IF line_exists( lt_variat_appr_stat[ status = zif_ppm_variation_wf_c=>c_flow_status-in_progress ] ).
                MESSAGE e005(zppm_var) WITH ls_qmel-qmnum.
                RETURN.
              ENDIF.
              IF line_exists( lt_variat_appr_stat[ status = zif_ppm_variation_wf_c=>c_flow_status-approved  ] ).
                MESSAGE I006(zppm_var) WITH ls_qmel-qmnum.
                RETURN.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDMETHOD.
