@Metadata.ignorePropagatedAnnotations: true
define view entity ZI_PPM_WORKFLOW_REPORT as select from ZI_PPM_DECPNT_STEP_REPORT_DTL
{
    key StepUUID,
    
    @ObjectModel.text.element: ['PPMWorkflowText']
    PPMWorkflowID,
    PPMWorkflowText,
    VariationType,
    VariationReason,
    WorkflowSequence,
    WorkflowGovernanceRole,
    WorkflowAction,
    StatusText,
    Note,
    Agent,
    ProcessorEmail,
    LocalLastChangedAt,
    PortfolioItemGuID,
    
    @ObjectModel.text.element: ['PortfolioItemTextEN']
