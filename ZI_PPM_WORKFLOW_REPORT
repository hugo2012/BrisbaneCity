    //_AllSteps
    
} union all select from ZI_PPM_VARIAT_STEP_REPORT_DTL {
    key StepUUID,
    
    PPMWorkflowID,
    PPMWorkflowText,
    VariationType,
    VariationReason,
    WorkflowSequence,
    WorkflowGovernanceRole,
    WorkflowAction,
    StatusText,
    Note,
    Agent,
    ProcessorEmail,
    LocalLastChangedAt,
    PortfolioItemGuID,
    
    PortfolioItem,
    PortfolioItemTextEN,
    DecisionPointGuID,
    
    DecisionPoint,
    DecisionPointTextEN,
    
    //DecisionPoint workflow specific
    ParentWorkflowGUID as PPMWorkflowUUID
    //_AllSteps

}

