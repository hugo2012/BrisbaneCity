                                                      element: 'ProjectPortfolioItem'  }     }]
    PortfolioItem,
    PortfolioItemTextEN,
    DecisionPointGuID,
    
    @ObjectModel.text.element: ['DecisionPointTextEN']
    @Consumption.valueHelpDefinition: [{  entity: {   name: 'ZI_ProjPrtfloItmDcsnPntType_VH' , 
                                                      element: 'DPType'  }     }]
    DecisionPoint,
    DecisionPointTextEN,
    
