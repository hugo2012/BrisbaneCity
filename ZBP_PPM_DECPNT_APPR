  METHOD buildNextStep.
    DATA error_msg TYPE bapi_msg.
    DATA transition_err_msg TYPE REF TO zcl_eppm_messagewrapper.
    DATA next_counter TYPE crmt_item_no.
    DATA(fields) = keys[ 1 ].
    DATA approval_complete TYPE abap_bool.

    "What should the new counter be? How many steps do we have already?
    READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
      ENTITY zi_ppm_decpnt_appr
      ALL FIELDS WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
      RESULT DATA(flows)
      ENTITY zi_ppm_decpnt_appr
      BY \_Steps
      ALL FIELDS WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
      RESULT DATA(existing_steps)
      FAILED failed
      REPORTED reported.

    IF failed-zi_ppm_decpnt_appr IS INITIAL AND failed-step IS INITIAL.
*    IF LINES( flows ) = 0.
*        transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
*                                    TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_MAIN_WF_READ
*                                    SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
*                                    MAIN_WF_GUID = fields-WfinstMain ).
*    ELSE.
        DATA(flow) = flows[ 1 ].
        DATA(count) = LINES( existing_steps ).
        DATA(new_count) = count + 1.
        WRITE new_count to next_counter.

        "read the sequence and position of the last step that was added
        "NB the *sequence* comes from the stakeholders table and is maintained by the users
        "whereas the *counter* is a strict index of the steps created for this approval run

        "NB no top/limit feature in EML, so we must find the latest entry
        SORT existing_steps BY Counter DESCENDING.
        DATA prev_step LIKE LINE OF existing_steps.
        IF LINES( existing_steps ) > 0.
            prev_step = existing_steps[ 1 ].
        ENDIF.

        "read the PPM item ID
        SELECT SINGLE ProjectPortfolioItem FROM ZI_ProjectPortfolioItemBasic WITH PRIVILEGED ACCESS
         WHERE ProjectPortfolioItemUUID = @flow-ItemGuID
         INTO @DATA(item_id).

        IF sy-subrc <> 0.
            transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_PORTFOLIO_ITEM_READ
                                SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                ITEM_GUID = flow-ItemGuID
                                SUBRC     = sy-subrc ).
        ELSE.
            "populate a range of the workflow actions relevant for approvals
            DATA: r_approval_actions TYPE RANGE OF zwrkflow_act,
                  lsr_approval_action LIKE LINE OF r_approval_actions.

            lsr_approval_action-sign = 'I'.
            lsr_approval_action-option = 'EQ'.

            lsr_approval_action-low = c_workflow_action-endorser.
            APPEND lsr_approval_action to r_approval_actions.

            lsr_approval_action-low = c_workflow_action-approver_phase.
            APPEND lsr_approval_action to r_approval_actions.

            IF flow-InvestmentApprovalRequired = 'X'.
                lsr_approval_action-low = c_workflow_action-approver_invest.
                APPEND lsr_approval_action to r_approval_actions.
            ENDIF.

            "read the next stakeholder from the stakeholders table
            "NB we tolerate duplicates with the same workflow sequence but different position IDs, to be
            "processed in an arbitrary order
            SELECT FROM zeppm_proj_roles
                   FIELDS position_id,
                          des_point_govrole,
                          workflow_action,
                          workflow_seq
                   WHERE ppm_item = @item_id AND
                         workflow_seq GE @prev_step-WorkflowSequence AND
                         workflow_action IN @r_approval_actions
                   ORDER BY workflow_seq ASCENDING
                   INTO TABLE @DATA(stakeholders).

            IF prev_step-PositionID IS NOT INITIAL.
                "exclude the row that we did last time (NB we are tolerating duplication of workflow sequence)
                DELETE stakeholders WHERE position_id = prev_step-PositionID AND
                                          workflow_seq = prev_step-WorkflowSequence.
            ENDIF.

            DATA: new_step_uuid TYPE rpm_tv_guid,
                  approval_mode TYPE abap_boolean VALUE IS INITIAL,
                  next_sequence TYPE zwrkflow_seq1,
                  new_steps TYPE TABLE FOR CREATE zi_ppm_decpnt_appr\_Steps,
                  agents TYPE STANDARD TABLE OF ZA_PPM_DEC_PNT_STAKEHOLDER,
                  agent LIKE LINE OF agents,
                  holder_summary TYPE fincs_long_text_250.

            IF LINES( stakeholders ) > 0.
                "approval is not yet complete, add the next decision entry
                DATA(next_stakeholder) = stakeholders[ 1 ].
                next_sequence = next_stakeholder-workflow_seq.
                IF next_stakeholder-workflow_action NE c_workflow_action-endorser.
                    approval_mode = 'X'.
                ENDIF.

                IF next_stakeholder-position_id IS NOT INITIAL.
                    "is the position ID valid?
                    SELECT COUNT( * )
                        FROM I_HCMObject
                        INTO @DATA(pos_match_count)
                        WHERE HCMPlanVersion = @c_plan_version_active AND
                              HCMObjectType = @c_type_position AND
                              HCMObjectID = @next_stakeholder-position_id AND
                              StartDate <= @sy-datum AND
                              EndDate >= @sy-datum.
                    IF pos_match_count > 0.
                        "get the holders of this position
                        READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
                            ENTITY zi_ppm_decpnt_appr
                            EXECUTE getHolders
                            FROM VALUE #( ( %param = VALUE #( PositionID = next_stakeholder-position_id ) ) )
                            RESULT DATA(holders)
                            REPORTED reported.
                        IF reported-zi_ppm_decpnt_appr IS INITIAL.
                            IF LINES( holders ) > 0.
                                agents = VALUE #( ( ) ( ) ( ) ).       "ensure that there are at least 3 rows, for up to 3 agents
                                LOOP AT holders INTO DATA(holder).
                                    IF sy-tabix > 3.
                                        EXIT.
                                    ENDIF.
                                    agents[ sy-tabix ]-Email  = holder-%param-Email.
                                    agents[ sy-tabix ]-UserID = holder-%param-UserID.

                                    IF sy-tabix = 1.
                                        holder_summary = holder-%param-Email.
                                    ELSE.
                                        holder_summary = holder_summary && |, | && holder-%param-Email.
                                    ENDIF.
                                ENDLOOP.
                            ELSE.
                                MESSAGE E003(ZEPPM) WITH next_stakeholder-position_id
                                                         next_stakeholder-workflow_seq INTO error_msg.      "Position &1 (sequence &2) is empty
                            ENDIF.
                        ELSE.
                            APPEND VALUE #( %tky = fields-%tky ) TO failed-zi_ppm_decpnt_appr.
                            EXIT.
                        ENDIF.
                   ELSE.
                    MESSAGE E001(ZEPPM) WITH next_stakeholder-position_id
                                             next_stakeholder-workflow_seq INTO error_msg.              "Position &1 is invalid (sequence &2)
                   ENDIF.
                ELSE.
                  MESSAGE E000(ZEPPM) WITH next_stakeholder-workflow_seq INTO error_msg.                "Choose a position for sequence &1
                ENDIF.
            ELSEIF LINES( existing_steps ) = 0.
                "this is the first step but there aren't any stakeholders
                MESSAGE E002(ZEPPM) INTO error_msg.                 "Please maintain at least 1 endorser or approver (Maintain Project Roles)
            ELSE.
              approval_complete = 'X'.
            ENDIF.

            IF error_msg IS NOT INITIAL.
                "invalid project roles config
                steps_out = VALUE #( ( WfinstMain = fields-WfinstMain
                                       %param = VALUE #(  MessageText = error_msg ) ) ).
                "save the step with the message
                new_steps = VALUE #(
                        ( WfinstMain = fields-WfinstMain
                          %target = VALUE #( ( %cid = 'cid1'
                                               wfinstmain = fields-WfinstMain
                                               counter = next_counter
                                               Status = c_step_status-config_error
                                               MessageText = error_msg
                                               WorkflowSequence = next_sequence
                                               WorkflowAction = next_stakeholder-workflow_action
                                               PositionID = next_stakeholder-position_id ) ) )
                        ).
                MODIFY ENTITY IN LOCAL MODE zi_ppm_decpnt_appr
                        CREATE BY \_Steps
                        FIELDS ( WfinstMain Counter Status WorkflowSequence WorkflowAction PositionID MessageText ) WITH new_steps.
            ELSEIF approval_complete = 'X'.
                "workflow interprets initial value as the end of approval
                steps_out = VALUE #( ( WfinstMain = fields-WfinstMain ) ).
            ELSE.
               new_steps = VALUE #(
                        ( WfinstMain = fields-WfinstMain
                          %target = VALUE #( ( %cid = 'cid1'
                                               wfinstmain = fields-WfinstMain
                                               counter = next_counter
                                               WorkflowSequence = next_sequence
                                               WorkflowAction = next_stakeholder-workflow_action
                                               GovernanceRole = next_stakeholder-des_point_govrole
                                               HolderSummary = holder_summary
                                               PositionID = next_stakeholder-position_id )
                                            ) )
                        ).

                MODIFY ENTITY IN LOCAL MODE zi_ppm_decpnt_appr
                        CREATE BY \_Steps
                        FIELDS ( WfinstMain Counter WorkflowSequence WorkflowAction
                                 GovernanceRole PositionID HolderSummary MessageText ) WITH new_steps
                        FAILED DATA(failed_msg)
                        REPORTED DATA(rep_msg).

                "read new record
                READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
                        ENTITY zi_ppm_decpnt_appr
                        BY \_Steps
                        ALL FIELDS WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
                        RESULT DATA(steps_added).

                        "NB no top/limit feature in EML, so we must find the latest entry
                        SORT steps_added BY Counter DESCENDING.
                        DATA(step_added) = steps_added[ 1 ].
                        new_step_uuid = step_added-StepUUID.


                "store the current step UUID on the header
                MODIFY ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
                   ENTITY zi_ppm_decpnt_appr
                    UPDATE FIELDS ( CurrentStepUUID )
                    WITH VALUE #(
                        ( WfinstMain = fields-WfinstMain
                          CurrentStepUUID = new_step_uuid )
                    )
                    FAILED DATA(failed_currstep)
                    REPORTED DATA(rep_currstep).

                    steps_out = VALUE #(
                                ( WfinstMain = fields-WfinstMain
                                  %param = VALUE #( Counter      = next_counter
                                                    StepUUID     = new_step_uuid
                                                    Agent1Email  = agents[ 1 ]-Email
                                                    Agent2Email  = agents[ 2 ]-Email
                                                    Agent3Email  = agents[ 3 ]-Email
                                                    Agent1UserID = agents[ 1 ]-UserID
                                                    Agent2UserID = agents[ 2 ]-UserID
                                                    Agent3UserID = agents[ 3 ]-UserID
                                                    ApprovalMode = approval_mode )
                                )
                            ).
              ENDIF.
          ENDIF.
      ENDIF.

      IF transition_err_msg IS NOT INITIAL.
        APPEND VALUE #( %MSG = transition_err_msg ) TO REPORTED-ZI_PPM_DECPNT_APPR.
        APPEND VALUE #( %tky = fields-%tky ) TO failed-zi_ppm_decpnt_appr.
      ENDIF.
  ENDMETHOD.

  METHOD getconfigerrordetails.
    DATA transition_err_msg TYPE REF TO zcl_eppm_messagewrapper.
    DATA(fields) = keys[ 1 ].

    "the error message will have been saved against the latest step
    READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
      ENTITY zi_ppm_decpnt_appr
      BY \_Steps
      ALL FIELDS WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
      RESULT DATA(existing_steps)
      FAILED failed
      REPORTED reported.

    IF  failed-zi_ppm_decpnt_appr IS INITIAL AND
        failed-step IS INITIAL.
        "NB no top/limit feature in EML, so we must find the latest entry
        SORT existing_steps BY Counter DESCENDING.
        DATA prev_step LIKE LINE OF existing_steps.
        IF LINES( existing_steps ) > 0.
            prev_step = existing_steps[ 1 ].
        ENDIF.

        "read the sys admin from the project roles table
        DATA agents TYPE STANDARD TABLE OF ZA_PPM_DEC_PNT_STAKEHOLDER.
        agents = VALUE #( ( ) ( ) ( ) ).

        READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
            ENTITY zi_ppm_decpnt_appr
            EXECUTE getBusinessSupport
            FROM VALUE #(   ( WfinstMain = fields-WfinstMain ) )
            RESULT DATA(support)
            FAILED failed
            REPORTED reported.

        IF failed-zi_ppm_decpnt_appr IS INITIAL.
            LOOP AT support INTO DATA(support_in).
                IF sy-tabix > 3.
                    EXIT.
                ENDIF.
                agents[ sy-tabix ]-Email  = support_in-%param-Email.
                agents[ sy-tabix ]-UserID = support_in-%param-UserID.
            ENDLOOP.

            IF sy-subrc = 0.
                error_details = VALUE #(
                                    ( WfinstMain = fields-WfinstMain
                                      %param = VALUE #( MessageText  = prev_step-MessageText
                                                        Agent1Email  = agents[ 1 ]-Email
                                                        Agent2Email  = agents[ 2 ]-Email
                                                        Agent3Email  = agents[ 3 ]-Email
                                                        Agent1UserID = agents[ 1 ]-UserID
                                                        Agent2UserID = agents[ 2 ]-UserID
                                                        Agent3UserID = agents[ 3 ]-UserID )
                                    )
                                ).
            ELSE.
                transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                            TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_NO_BUS_SUPPORT
                                            SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                            MAIN_WF_GUID = fields-WfinstMain ).
            ENDIF.
         ENDIF.
      ENDIF.

    IF transition_err_msg IS NOT INITIAL.
        APPEND VALUE #( %MSG = transition_err_msg ) TO REPORTED-ZI_PPM_DECPNT_APPR.
        APPEND VALUE #( %tky = fields-%tky ) TO failed-zi_ppm_decpnt_appr.
    ENDIF.
  ENDMETHOD.

  METHOD APPROVALCOMPLETED.
     DATA:  keys_out TYPE TABLE FOR ACTION IMPORT zi_ppm_decpnt_appr~setFlowStatus.
     keys_out = CORRESPONDING #( keys ).

     "read the flow header to get the decision point GUID and read all the steps to get the latest action e.g. approve or reject
     DATA(fields) = keys[ 1 ].
     READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
       ENTITY zi_ppm_decpnt_appr
        FIELDS ( DecisionGuID ) WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
        RESULT DATA(flows)
       ENTITY zi_ppm_decpnt_appr
        BY \_Steps
        ALL FIELDS WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
        RESULT DATA(all_steps)
        FAILED failed
        REPORTED reported.

     IF failed-zi_ppm_decpnt_appr IS INITIAL AND
        failed-step IS INITIAL.
         DATA(flow) = flows[ 1 ].

         "NB no top/limit feature in EML, so we must find the latest entry
         SORT all_steps BY Counter DESCENDING.
         DATA(final_step) = all_steps[ 1 ].

         "get the decision point ID to see if pre-feasibility (and was approved)
         SELECT SINGLE ProjPrtfloItemDecisionPoint FROM ZI_ProjPrtfloItmDcsnPointBasic WITH PRIVILEGED ACCESS
         WHERE ProjPrtfloItmDcsnPointUUID = @flow-DecisionGuID
         INTO @DATA(dp_id).

         IF sy-subrc = 0.
             IF final_step-Status = c_step_status-approved and dp_id = c_dp_prefeasibility.
                "change of portfolio item status is required for approved pre-feasibility gate
                keys_out[ 1 ]-%param-NewStatus = c_flow_status-pi_status_pending.
             ELSE.
                "only status change required is for decision point
                keys_out[ 1 ]-%param-NewStatus = c_flow_status-dp_status_pending.
             ENDIF.

             setflowstatus( EXPORTING keys = keys_out
                            CHANGING  reported = reported
                                      failed = failed ).
         ELSE.
             APPEND VALUE #( %MSG = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                        TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_READ_DP_HDR
                                        SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                        DP_GUID  = flow-DecisionGuID
                                        SUBRC    = sy-subrc ) ) TO REPORTED-ZI_PPM_DECPNT_APPR.
            APPEND VALUE #( %tky = fields-%tky ) TO failed-zi_ppm_decpnt_appr.
         ENDIF.
     ENDIF.
  ENDMETHOD.

  METHOD CANCELLED.
     DATA transition_err_msg TYPE REF TO zcl_eppm_messagewrapper.
     DATA(fields) = keys[ 1 ].
     DATA keys_out TYPE TABLE FOR ACTION IMPORT zi_ppm_decpnt_appr~setFlowStatus.
     keys_out = CORRESPONDING #( keys ).
     keys_out[ 1 ]-%param-NewStatus = c_flow_status-cancelled.
     setflowstatus( EXPORTING keys = keys_out
                    CHANGING  reported = reported
                              failed = failed ).

     IF LINES( failed-zi_ppm_decpnt_appr ) = 0.
         "read the flow to get the final step UUID
         READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
           ENTITY zi_ppm_decpnt_appr
            FIELDS ( FinalStepUUID ) WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
            RESULT DATA(flows)
            FAILED DATA(failed_read).
         DATA(flow) = flows[ 1 ].

         IF failed_read-zi_ppm_decpnt_appr IS INITIAL.
             "set the status of that step to cancelled
             DATA keys_out_step TYPE TABLE FOR ACTION IMPORT zi_ppm_decpnt_step~record_decision.
             keys_out_step = CORRESPONDING #( keys ).
             keys_out_step[ 1 ]-%param-NewStatus = c_step_status-cancelled.
             keys_out_step[ 1 ]-StepUUID = flow-FinalStepUUID.

             "read the email address (used for consistency) of the user who triggered the cancellation
             SELECT SINGLE \_AddrCurDefaultEmailAddress-EmailAddress
                           FROM I_USER
                           WHERE USERID = @fields-%param-UserID
                           INTO @DATA(email) PRIVILEGED ACCESS.

             keys_out_step[ 1 ]-%param-ProcessorEmail = email.

             record_decision( EXPORTING keys = keys_out_step ).
         ELSE.
             APPEND VALUE #( %MSG = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                        TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_READ_LATEST_STEP
                                        SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                        MAIN_WF_GUID = fields-WfinstMain
                                        CAUSE        = failed_read-zi_ppm_decpnt_appr[ 1 ]-%fail-cause )
                           ) TO REPORTED-ZI_PPM_DECPNT_APPR.
             APPEND VALUE #( %tky = fields-%tky ) TO failed-zi_ppm_decpnt_appr.
         ENDIF.
     ENDIF.
  ENDMETHOD.

  METHOD SETFLOWSTATUS.
    DATA transition_err_msg TYPE REF TO zcl_eppm_messagewrapper.
    DATA(fields) = keys[ 1 ].

    "read the last step
    READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
        ENTITY zi_ppm_decpnt_appr
        BY \_Steps
        ALL FIELDS WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
        RESULT DATA(all_steps)
        FAILED DATA(failed_read).

    IF failed_read-zi_ppm_decpnt_appr IS INITIAL.
        "NB no top/limit feature in EML, so we must find the latest entry
        SORT all_steps BY Counter DESCENDING.
        DATA(final_step) = all_steps[ 1 ].


        "set the status and save the final step uuid
        MODIFY ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
           ENTITY zi_ppm_decpnt_appr
            UPDATE FIELDS ( FinalStepUUID Status )
            WITH VALUE #(
                ( WfinstMain = fields-WfinstMain
                  FinalStepUUID = final_step-StepUUID
                  Status = fields-%param-NewStatus )
            )
            FAILED DATA(failed_upd)
            REPORTED DATA(rep_msg).

        IF failed_upd-zi_ppm_decpnt_appr IS NOT INITIAL.
            transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                    TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_UPD_FLOW_HDR
                                    SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                    MAIN_WF_GUID = fields-WfinstMain
                                    CAUSE        = failed_upd-zi_ppm_decpnt_appr[ 1 ]-%fail-cause ).
        ENDIF.
    ELSE.
        transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                    TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_READ_LATEST_STEP
                                    SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                    MAIN_WF_GUID = fields-WfinstMain
                                    CAUSE        = failed_read-zi_ppm_decpnt_appr[ 1 ]-%fail-cause ).
    ENDIF.

    IF transition_err_msg IS NOT INITIAL.
        APPEND VALUE #( %MSG = transition_err_msg ) TO REPORTED-ZI_PPM_DECPNT_APPR.
        APPEND VALUE #( %tky = fields-%tky ) TO failed-zi_ppm_decpnt_appr.
    ENDIF.
  ENDMETHOD.

* check if the decision point status has been set correctly
  METHOD decPntStatusSet.
    DATA transition_err_msg TYPE REF TO zcl_eppm_messagewrapper.
    DATA(fields) = keys[ 1 ].

    "read the actual status of the decision point
    READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
       ENTITY zi_ppm_decpnt_appr
        FIELDS ( DecisionGuID ) WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
        RESULT DATA(flows)
        FAILED failed
        REPORTED reported.

    IF failed-zi_ppm_decpnt_appr IS INITIAL.
        DATA(flow) = flows[ 1 ].

        SELECT SINGLE ProjPrtfloItmDcsnPointStatus FROM ZI_ProjPrtfloItmDcsnPointBasic WITH PRIVILEGED ACCESS
            WHERE ProjPrtfloItmDcsnPointUUID = @flow-DecisionGuID
            INTO @DATA(dp_status).

        IF sy-subrc = 0.
            "target status depends on the decision taken on the last approval step
            READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
                ENTITY zi_ppm_decpnt_appr
                BY \_Steps
                ALL FIELDS WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
                RESULT DATA(all_steps)
                FAILED failed
                REPORTED reported.

            IF failed-step IS INITIAL.
                "NB no top/limit feature in EML, so we must find the latest entry
                SORT all_steps BY Counter DESCENDING.
                DATA(final_step) = all_steps[ 1 ].

                DATA: target_status TYPE /rpm/tv_status_common,
                      status_ok TYPE abap_boolean VALUE IS INITIAL.

                CASE final_step-Status.
                  WHEN c_step_status-more_info_req.
                    target_status = c_dp_status-in_progress.

                  WHEN c_step_status-on_hold.
                    target_status = c_dp_status-on_hold.

                  WHEN c_step_status-rejected.
                    target_status = c_dp_status-rejected.

                  WHEN OTHERS.
                    target_status = c_dp_status-approved.

                ENDCASE.

                IF target_status = dp_status.
                    "the status has been updated as we expected
                    status_ok = 'X'.

                    "update the workflow header status
                    DATA keys_out TYPE TABLE FOR ACTION IMPORT zi_ppm_decpnt_appr~setFlowStatus.
                    keys_out = CORRESPONDING #( keys ).
                    keys_out[ 1 ]-%param-NewStatus = c_flow_status-completed.
                    setflowstatus( EXPORTING keys = keys_out
                                   CHANGING  reported = reported
                                             failed = failed ).
                ENDIF.

                valid = VALUE #( ( WfinstMain = fields-WfinstMain
                                   %param = VALUE #( Valid = status_ok ) ) ).
            ENDIF.
        ELSE.
            transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                    TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_READ_DP_HDR
                                    SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                    DP_GUID  = flow-DecisionGuID
                                    SUBRC = sy-subrc ).
        ENDIF.
    ENDIF.

    IF transition_err_msg IS NOT INITIAL.
        APPEND VALUE #( %MSG = transition_err_msg ) TO REPORTED-ZI_PPM_DECPNT_APPR.
        APPEND VALUE #( %tky = fields-%tky ) TO failed-zi_ppm_decpnt_appr.
    ENDIF.
  ENDMETHOD.

* check if the portfolio item status has been set correctly
  METHOD itemStatusSet.
    DATA(fields) = keys[ 1 ].

    "read the status of the portfolio item
    READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
       ENTITY zi_ppm_decpnt_appr
        FIELDS ( ItemGuID ) WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
        RESULT DATA(flows)
        FAILED failed
        REPORTED reported.

    IF failed-zi_ppm_decpnt_appr IS INITIAL.
        DATA(flow) = flows[ 1 ].

        SELECT SINGLE ProjectPortfolioItemStatus FROM ZI_ProjectPortfolioItemBasic WITH PRIVILEGED ACCESS
         WHERE ProjectPortfolioItemUUID = @flow-ItemGuID
         INTO @DATA(item_status).

        DATA status_ok TYPE abap_boolean VALUE IS INITIAL.

        IF item_status = c_pi_status-approved.
            "the portfolio item has been updated as we expected
            status_ok = 'X'.

            "update the workflow header status
            DATA keys_out TYPE TABLE FOR ACTION IMPORT zi_ppm_decpnt_appr~setFlowStatus.
            keys_out = CORRESPONDING #( keys ).
            keys_out[ 1 ]-%param-NewStatus = c_flow_status-dp_status_pending.   "decision point status set will always follow
            setflowstatus( EXPORTING keys = keys_out
                           CHANGING  reported = reported
                                     failed = failed ).
        ENDIF.

        valid = VALUE #( (  WfinstMain = fields-WfinstMain
                            %param = VALUE #( Valid = status_ok ) ) ).
    ENDIF.
  ENDMETHOD.

**********************************************************************
* STEPS
**********************************************************************
  METHOD approve.
     DATA keys_out TYPE TABLE FOR ACTION IMPORT zi_ppm_decpnt_step~record_decision.
     keys_out = CORRESPONDING #( keys ).
     keys_out[ 1 ]-%param-NewStatus = c_step_status-approved.
     record_decision( EXPORTING keys = keys_out
                      CHANGING  reported = reported
                                failed   = failed ).
  ENDMETHOD.

  METHOD endorse.
     DATA keys_out TYPE TABLE FOR ACTION IMPORT zi_ppm_decpnt_step~record_decision.
     keys_out = CORRESPONDING #( keys ).
     keys_out[ 1 ]-%param-NewStatus = c_step_status-endorsed.
     record_decision( EXPORTING keys = keys_out
                      CHANGING  reported = reported
                                failed   = failed ).
  ENDMETHOD.

  METHOD reject.
     DATA keys_out TYPE TABLE FOR ACTION IMPORT zi_ppm_decpnt_step~record_decision.
     keys_out = CORRESPONDING #( keys ).
     keys_out[ 1 ]-%param-NewStatus = c_step_status-rejected.
     record_decision( EXPORTING keys = keys_out
                      CHANGING  reported = reported
                                failed   = failed ).
  ENDMETHOD.

  METHOD requestMoreInfo.
     DATA keys_out TYPE TABLE FOR ACTION IMPORT zi_ppm_decpnt_step~record_decision.
     keys_out = CORRESPONDING #( keys ).
     keys_out[ 1 ]-%param-NewStatus = c_step_status-more_info_req.
