* FLOW
**********************************************************************
  METHOD getStakeholders.
    DATA(fields) = keys[ 1 ].
    DATA transition_err_msg TYPE REF TO zcl_eppm_messagewrapper.

    "read the workflow header
    READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
      ENTITY zi_ppm_decpnt_appr
      ALL FIELDS WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
      RESULT DATA(flows).

    IF LINES( flows ) = 1.
        DATA(flow) = flows[ 1 ].

        "read the PPM item ID
        SELECT SINGLE ProjectPortfolioItem FROM ZI_ProjectPortfolioItemBasic WITH PRIVILEGED ACCESS
         WHERE ProjectPortfolioItemUUID = @flow-ItemGuID
         INTO @DATA(item_id).

        IF sy-subrc = 0.
            "populate a range of the workflow actions relevant for the stakeholders email
            DATA: r_actions TYPE RANGE OF zwrkflow_act,
                  lsr_action LIKE LINE OF r_actions.

            lsr_action-sign = 'I'.
            lsr_action-option = 'EQ'.

            lsr_action-low = c_workflow_action-endorser.
            APPEND lsr_action to r_actions.

            lsr_action-low = c_workflow_action-approver_phase.
            APPEND lsr_action to r_actions.

            lsr_action-low = c_workflow_action-approver_invest.
            APPEND lsr_action to r_actions.

            lsr_action-low = c_workflow_action-interested.
            APPEND lsr_action to r_actions.

            DATA: positions TYPE STANDARD TABLE OF ZA_PPM_DECPNT_POSITION,
                  stakeholder LIKE LINE OF all_stakeholders.

            "read the relevant stakeholders for this portfolio item
            SELECT FROM zeppm_proj_roles
                   FIELDS position_id
                   WHERE ppm_item = @item_id AND
                         workflow_action IN @r_actions AND
                         position_id IS NOT INITIAL
                   INTO TABLE @positions.

            SORT positions BY PositionID.
            DELETE ADJACENT DUPLICATES FROM positions COMPARING PositionID.

            "get the holders of these positions and append to the output table
            stakeholder-WfinstMain = fields-WfinstMain.
            LOOP AT positions INTO DATA(position).
                READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
                    ENTITY zi_ppm_decpnt_appr
                    EXECUTE getHolders
                    FROM VALUE #( ( %param = VALUE #( PositionID = position-PositionID ) ) )
                    RESULT DATA(holders)
                    REPORTED reported.
                IF reported-zi_ppm_decpnt_appr IS INITIAL.
                    LOOP AT holders INTO DATA(holder_in).
                      IF holder_in-%param-Email IS NOT INITIAL.
                          stakeholder-%param-Email  = holder_in-%param-Email.
                          stakeholder-%param-UserID = holder_in-%param-UserID.
                          APPEND stakeholder TO all_stakeholders.
                      ENDIF.
                    ENDLOOP.
                ELSE.
                    APPEND VALUE #( %tky = fields-%tky ) TO failed-zi_ppm_decpnt_appr.
                    EXIT.
                ENDIF.
            ENDLOOP.

            SORT all_stakeholders BY %param-Email.
            DELETE ADJACENT DUPLICATES FROM all_stakeholders COMPARING %param-Email.
        ELSE.
            transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                        TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_PORTFOLIO_ITEM_READ
                                        SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                        ITEM_GUID = flow-ItemGuID
                                        SUBRC     = sy-subrc ).
        ENDIF.
    ELSE.
        transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                    TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_MAIN_WF_READ
                                    SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                    MAIN_WF_GUID = fields-WfinstMain ).
    ENDIF.

    IF transition_err_msg IS NOT INITIAL.
        APPEND VALUE #( %MSG = transition_err_msg ) TO REPORTED-ZI_PPM_DECPNT_APPR.
        APPEND VALUE #( %tky = fields-%tky ) TO failed-zi_ppm_decpnt_appr.
    ENDIF.
  ENDMETHOD.

  METHOD getProjectManagers.
    DATA(fields) = keys[ 1 ].

    READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
        ENTITY zi_ppm_decpnt_appr
        EXECUTE getRoleHolders
        FROM VALUE #(   ( WfinstMain = fields-WfinstMain
                          %param = VALUE #( RoleID = c_proj_role-project_manager ) ) )
        RESULT DATA(holders)
        FAILED failed
        REPORTED reported.

        MOVE-CORRESPONDING holders TO managers.
  ENDMETHOD.

