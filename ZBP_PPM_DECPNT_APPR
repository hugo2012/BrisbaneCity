  ENDMETHOD.

  METHOD putOnHold.
     DATA keys_out TYPE TABLE FOR ACTION IMPORT zi_ppm_decpnt_step~record_decision.
     keys_out = CORRESPONDING #( keys ).
     keys_out[ 1 ]-%param-NewStatus = c_step_status-on_hold.
     record_decision( EXPORTING keys    = keys_out
                      CHANGING reported = reported
                               failed   = failed ).
  ENDMETHOD.

  METHOD record_decision.
    DATA(fields) = keys[ 1 ].
    DATA(params) = fields-%param.

    MODIFY ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
           ENTITY Step
            UPDATE FIELDS ( Status Note ProcessorEmail )
            WITH VALUE #(
                ( StepUUID = fields-StepUUID
                  Status = params-NewStatus
                  Note = params-Note
                  ProcessorEmail = params-ProcessorEmail )
            )
            FAILED failed
            REPORTED reported.

  ENDMETHOD.

* get a url to the portfolio item screen which can be included in a link in the work items
  METHOD getPortfolioItemURL.

    DATA(fields) = keys[ 1 ].

    DATA: full_url TYPE lcm_url,
          flp_url TYPE lcm_url.

*    CALL METHOD /ui2/cl_lsapi_manager=>create_flp_url( EXPORTING object = 'Shell'
*                                                                 action = 'startWDA'
*                                                       RECEIVING url = flp_url ).

    CALL METHOD zcl_wrap_api_manager_dp=>zif_wrap_api_manager_dp~create_flp_url(  EXPORTING   object = 'Shell'
                                                                                              action = 'startWDA'
                                                                                  RECEIVING   url = flp_url ).

    "correct client (is wrong in d41)
    FIND FIRST OCCURRENCE OF '?sap-client=' IN flp_url MATCH OFFSET DATA(start_param).
    DATA(start_index_client) = start_param + 12.
    REPLACE SECTION OFFSET start_index_client LENGTH 3 OF flp_url WITH sy-mandt.

    "read the flow header to get the portfolio item GUID
    READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
       ENTITY zi_ppm_decpnt_appr
        FIELDS ( ItemGuID ) WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
        RESULT DATA(flow)
        FAILED failed
        REPORTED reported.

    IF failed-zi_ppm_decpnt_appr IS INITIAL.
        DATA(portfolio_item_uuid) = flow[ 1 ]-ItemGuID.

*    portfolio_item_uuid = '5F130FA3A00A1FE1849EF2D5C529252A'.

        "read the portfolio item details for parent bucket and portfolio UUIDs
        SELECT SINGLE ProjectPortfolioUUID,
                      ProjectPortfolioItemUUID,
                      ProjPrtfloItemParentObjectUUID FROM ZI_ProjectPortfolioItemBasic WITH PRIVILEGED ACCESS
         WHERE ProjectPortfolioItemUUID = @portfolio_item_uuid
         INTO @DATA(portfolio_item).

        "build the url
        full_url = flp_url &&       |?APPL_MODE=2&APPL_TYPE=RPM&CTX_PARENT_GUID={ portfolio_item-ProjectPortfolioUUID }| &&
                                    |&CTX_PARENT_TYPE=RPH&EDIT_MODE=2&IS_STATUS_LOCKED=&MAIN_PORTFOLIO_GUID=00000000000000000000000000000000| &&
                                    |&OBJECT_GUID={ portfolio_item-ProjectPortfolioItemUUID }| &&
                                    |&OBJECT_ID=&OBJECT_TYPE=RIH&PARENT_GUID={ portfolio_item-ProjPrtfloItemParentObjectUUID }| &&
                                    |&PARENT_ID=&PARENT_TYPE=RBH&PORTAL_ROLE=RPM_PORT&PORTFOLIO_GUID={ portfolio_item-ProjectPortfolioUUID }| &&
                                    |&PORTFOLIO_ID=&VIEW_TEMP=&sap-app-origin-hint=&sap-system=S4PPM&sap-ui2-wd-app-id=RPM_ITEM_DETAILS&| &&
                                    |sap-ui2-wd-conf-id=RPM_ITEM_DETAILS_CFG&sap-ushell-navmode=explace&sap-ie=edge&sap-theme=sap_horizon&sap-touch=0|.

        portfolio_item_url = VALUE #(
                        ( WfinstMain = fields-WfinstMain
                          %param = VALUE #( Url = full_url )
                        )
                    ).
    ENDIF.


  ENDMETHOD.

ENDCLASS.
