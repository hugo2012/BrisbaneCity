  METHOD getDPManagers.
    DATA transition_err_msg TYPE REF TO zcl_eppm_messagewrapper.
    DATA(fields) = keys[ 1 ].

    READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
        ENTITY zi_ppm_decpnt_appr
        EXECUTE getActionParties
        FROM VALUE #( ( WfinstMain = fields-WfinstMain
                        %param = VALUE #( ActionID = c_workflow_action-decpnt_manager ) ) )
        RESULT DATA(parties).

        MOVE-CORRESPONDING parties TO managers.

    IF LINES( managers ) = 0.
        "the project roles table doesn't have any valid DP manager, so read the workflow header to get the actual initiator
        READ ENTITIES OF zi_ppm_decpnt_appr IN LOCAL MODE
          ENTITY zi_ppm_decpnt_appr
          FIELDS ( LocalCreatedBy )
          WITH VALUE #( ( WfinstMain = fields-WfinstMain ) )
          RESULT DATA(user_ids).

        IF sy-subrc = 0.
            IF LINES( user_ids ) > 0.
                DATA(user_id) = user_ids[ 1 ]-LocalCreatedBy.
                "read the default email address of this user
                SELECT SINGLE DefaultEmailAddress FROM ZI_BusinessUserDetails WITH PRIVILEGED ACCESS
                WHERE UserID = @user_id
                INTO @DATA(user).
                IF sy-subrc = 0.
                    IF user IS NOT INITIAL.
                        DATA manager LIKE LINE OF managers.
                        manager-%param-Email  = user.
                        manager-%param-UserID = user_id.
                        APPEND manager TO managers.
                    ELSE.
                        transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                                    TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_USER_EMAIL_BLANK
                                                    SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                                    USERID   = user_id ).
                    ENDIF.
                ELSE.
                    transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                                TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_READ_USER_EMAIL
                                                SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                                USERID   = user_id
                                                SUBRC    = sy-subrc ).
                ENDIF.
            ENDIF.
        ELSE.
            transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                        TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_MAIN_WF_READ_CREATED_BY
                                        SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                        MAIN_WF_GUID = fields-WfinstMain
                                        SUBRC     = sy-subrc ).
        ENDIF.
    ENDIF.

    IF transition_err_msg IS NOT INITIAL.
        APPEND VALUE #( %MSG = transition_err_msg ) TO REPORTED-ZI_PPM_DECPNT_APPR.
        APPEND VALUE #( %tky = fields-%tky ) TO failed-zi_ppm_decpnt_appr.
    ENDIF.
  ENDMETHOD.

  METHOD getHolders.
    DATA transition_err_msg TYPE REF TO zcl_eppm_messagewrapper.
    DATA(fields) = keys[ 1 ].
    DATA(position_id) = fields-%param-PositionID.
    DATA count TYPE i.

    SELECT FROM ZI_PositionHolder_DP WITH PRIVILEGED ACCESS
                FIELDS UserID, EmailAddress
                WHERE PositionID = @position_id
                INTO TABLE @DATA(holders).

    IF sy-subrc = 0.
        DATA holder_out LIKE LINE OF position_holders.

        LOOP AT holders INTO DATA(holder).
            CLEAR holder_out.
            IF holder-EmailAddress IS NOT INITIAL.
                holder_out-%param-Email  = holder-EmailAddress.
                holder_out-%param-UserID = holder-UserID.
                APPEND holder_out TO position_holders.
            ELSE.
                transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                TEXTID     = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_USER_EMAIL_BLANK
                                SEVERITY   = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                USERID     = holder-UserID ).
                EXIT.
            ENDIF.
        ENDLOOP.
    ELSE.
        transition_err_msg = NEW ZCL_EPPM_MESSAGEWRAPPER(
                                    TEXTID   = ZCL_EPPM_MESSAGEWRAPPER=>ERROR_EMPTY_POS
                                    SEVERITY = IF_ABAP_BEHV_MESSAGE=>SEVERITY-ERROR
                                    POSID    = position_id ).
    ENDIF.

    IF transition_err_msg IS NOT INITIAL.
        APPEND VALUE #( %MSG = transition_err_msg ) TO REPORTED-zi_ppm_decpnt_appr.
    ENDIF.
  ENDMETHOD.

